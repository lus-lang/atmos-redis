local ROOT = string.match(TEST_DIR, "^(.*)[/\\][^/\\]*$")
local PACKAGES = string.match(ROOT, "^(.*)[/\\][^/\\]*$")
pledge("load", `fs:read=$PACKAGES/*`, "network:tcp", "env:read=LUS_TEST_REDIS")
local path = { `$ROOT/?.lus`, `$TEST_DIR/?.lus` }

for _, name in ipairs({ "rate_limit", "session", "queue", "cookie", "web" }) do
    path[#path + 1] = `$PACKAGES/$name/?.lus`
    path[#path + 1] = `$PACKAGES/atmos-$(name:gsub("_", "-"))/?.lus`
end

package.path = `$(table.concat(path, ";"));$(package.path)`

-- The session package requires cookie by its atmosphere URL. The tests load
-- the checkout next to this one in its place.
package.preload["https://atmosp.here/2.0/cookie.lus"] = function()
    return require("cookie")
end

-- Counts the sleeps that never run out, which are the waits for the pool.
-- The package reads `coroutine.sleep` when it loads.
local parks = 0

do
    local sleep = coroutine.sleep

    coroutine.sleep = function(seconds)
        if seconds == math.huge then
            parks = parks + 1
        end

        return sleep(seconds)
    end
end

local redis = require("redis")
local fake = require("fake_redis")

-- Every test talks to a fake server of its own on a loopback port. The
-- tests at the end of the file run against a real server when the
-- environment variable LUS_TEST_REDIS holds its URL.

local Env = {
    __close = function(env)
        for _, client in ipairs(env.clients) do
            client:close()
        end

        env.server:stop()
    end,
}

-- Starts a fake server and connects a client to it. The result closes both
-- at the end of its scope.
local function setup(server_options, client_options)
    local server = fake.start(server_options)
    local env = setmetatable({ server = server, clients = {} }, Env)

    function env:connect(options, url)
        local client = redis.connect(url or server.url, options)
        self.clients[#self.clients + 1] = client
        return client
    end

    if client_options ~= false then
        local ok, client = catch env:connect(client_options)

        if not ok then
            server:stop()
            error(client, 0)
        end

        env.r = client
    end

    return env
end

local function same(a, b)
    if type(a) ~= "table" or type(b) ~= "table" then
        return a == b
    end

    for k, v in pairs(a) do
        if not same(v, b[k]) then
            return false
        end
    end

    for k in pairs(b) do
        if a[k] == nil then
            return false
        end
    end

    return true
end

local function count(list, value)
    local n = 0

    for _, item in ipairs(list) do
        if item == value then
            n = n + 1
        end
    end

    return n
end

local function failure(fn)
    local ok, err = catch fn()
    assert(not ok, "the call must fail")
    return err
end

-- Connections --------------------------------------------------------------------

local function hello_test()
    local env <close> = setup()
    local r from env
    assert(r.resp == 3)
    assert(r.server.server == "fake" and r.server.proto == 3)
    assert(r:ping() == "PONG")
    assert(r:echo("hi") == "hi")
    assert(count(env.server.log, "PING") == 1)
end

local function url_test()
    local env <close> = setup({ username = "app", password = "p@ss:word" }, false)
    local server = env.server
    local r = env:connect(nil, `redis://app:p%40ss%3Aword@127.0.0.1:$(server.port)/2`)
    r:set("k", "v")
    assert(server.dbs[2].k.value == "v" and server.dbs[0].k == nil)
    -- Options replace the parts of a URL.
    local other = env:connect(
        { db = 3, client_name = "worker" },
        `valkey://app:p%40ss%3Aword@127.0.0.1:$(server.port)/2`
    )
    other:set("k", "w")
    assert(server.dbs[3].k.value == "w")
    assert(other:client_getname() == "worker")
end

local function invalid_arguments_test()
    raises(function()
        redis.connect("http://localhost")
    end, "invalid Redis URL")

    raises(function()
        redis.connect("redis://localhost/abc")
    end, "invalid database")

    raises(function()
        redis.connect(42)
    end, "string or table expected")

    raises(function()
        redis.connect({ hostname = "x" })
    end, "unknown redis option 'hostname'")

    raises(function()
        redis.connect({ port = "6379" })
    end, "'port' must be a number")
end

local function options_table_test()
    local env <close> = setup()
    local r = redis.connect({ host = "127.0.0.1", port = env.server.port, pool = 2 })
    assert(r:ping() == "PONG")
    r:close()
end

local function auth_test()
    local env <close> = setup({ password = "secret" }, { password = "secret" })
    assert(env.r:ping() == "PONG")

    local err = failure(function()
        env:connect({ password = "wrong" })
    end)

    assert(redis.is_error(err) and err.code == "WRONGPASS")

    err = failure(function()
        env:connect()
    end)

    assert(err.code == "NOAUTH")
end

local function connection_refused_test()
    local listener = network.tcp.bind("127.0.0.1", 0)
    local _, port = listener:getsockname()
    listener:close()

    local err = failure(function()
        redis.connect(`redis://127.0.0.1:$port`)
    end)

    assert(redis.is_error(err) and err.code == "CONNECTION")
    assert(tostring(err):find("cannot connect", 1, true))
end

-- A server that answers the TLS greeting of the client with plain text.
local function tls_to_plain_server_test()
    local listener <close> = network.tcp.bind("127.0.0.1", 0)
    local _, port = listener:getsockname()

    local serving = coroutine.detach(coroutine.create(function()
        local sock <close> = listener:accept()
        sock:receive(1)
        sock:send("-ERR this server speaks plain text\r\n")
    end))

    local err = failure(function()
        redis.connect(`rediss://127.0.0.1:$port`, { tls = { verify = false }, timeout = 5 })
    end)

    assert(redis.is_error(err) and err.code == "CONNECTION" and err.timeout == nil)
    assert(tostring(err):find("TLS", 1, true), tostring(err))
    coroutine.close(serving)
end

local function close_test()
    local env <close> = setup()
    local server = env.server

    do
        local r <close> = env:connect()
        assert(r:ping() == "PONG")
    end

    local r = env.clients[2]

    local err = failure(function()
        r:ping()
    end)

    assert(err.code == "CONNECTION" and err.message == "the client is closed")
    r:close()
    env.r:ping()
    assert(server.open == 1)
end

-- Commands -----------------------------------------------------------------------

local function get_set_test()
    local env <close> = setup()
    local r from env
    assert(r:set("k", "v") == "OK")
    assert(r:get("k") == "v")
    assert(r:get("missing") == nil)
    assert(r:set("n", 42) == "OK" and r:get("n") == "42")
    assert(r:set("f", 1.5) == "OK" and r:get("f") == "1.5")
    assert(r:set("whole", 3.0) == "OK" and r:get("whole") == "3")
    assert(
        r:set("big", 123456789012345678901234567890n) == "OK"
            and r:get("big") == "123456789012345678901234567890"
    )
    assert(r:set("flag", true) == "OK" and r:get("flag") == "1")
    assert(r:del("k", "n", "missing") == 2)
    assert(r:exists("k") == 0)
end

local function option_tables_test()
    local env <close> = setup()
    local r, server from env
    assert(r:set("k", "v", { ex = 60 }) == "OK")
    assert(r:ttl("k") == 60)
    server.now = server.now + 59000
    assert(r:get("k") == "v")
    server.now = server.now + 1000
    assert(r:get("k") == nil)
    assert(r:set("k", "a", { nx = true }) == "OK")
    assert(r:set("k", "b", { nx = true, px = 1500 }) == nil)
    assert(r:set("k", "c", { xx = true, get = true, px = 1500 }) == "a")
    assert(r:pttl("k") == 1500)
    -- A false flag adds nothing.
    assert(r:set("k", "d", { nx = false }) == "OK" and r:get("k") == "d")
end

local function counters_test()
    local env <close> = setup()
    local r, server from env
    assert(r:incr("visits") == 1)
    assert(r:incr("visits") == 2)
    assert(r:incrby("visits", 10) == 12)
    assert(r:ttl("visits") == -1)
    assert(r:expire("visits", 30) == 1)
    assert(r:ttl("visits") == 30)
    server.now = server.now + 30000
    assert(r:ttl("visits") == -2)
    assert(r:incr("visits") == 1)
end

local function hashes_test()
    local env <close> = setup()
    local r from env
    assert(r:hset("user:1", "name", "Ada") == 1)
    assert(r:hset("user:1", { age = 36, city = "London" }) == 2)
    assert(same(r:hgetall("user:1"), { name = "Ada", age = "36", city = "London" }))
    assert(r:hget("user:1", "age") == "36")
    assert(same(r:hgetall("missing"), {}))
    local values = r:hmget("user:1", "name", "nope", "city")
    assert(values[1] == "Ada" and values[2] == nil and values[3] == "London")
    -- An array inside a table expands in place.
    assert(r:hdel("user:1", { "age", "city" }) == 2)
end

local function call_test()
    local env <close> = setup()
    local r from env
    assert(r:call("SET", "k", "v") == "OK")
    assert(r:call("get", "k") == "v")
    assert(same(r:config_get("maxmemory"), { maxmemory = "0" }))
    assert(r:client_setname("me") == "OK" and r:client_getname() == "me")
    assert(r:type("k") == "string")

    raises(function()
        r:call()
    end, "needs a name")

    raises(function()
        r:get(nil)
    end, "argument #2 of the Redis command is nil")

    raises(function()
        r:set("k", print)
    end, "cannot send a function value")

    raises(function()
        r:set("k", { [1.5] = "x" })
    end, "cannot send a table with the key")

    raises(function()
        r:set("k", 0 / 0)
    end, "NaN")
end

local function reply_types_test()
    local env <close> = setup()
    local r from env
    local double = r:call("FAKE", "double", "2.5")
    assert(double == 2.5 and math.type(double) == "float")
    local inf = r:call("FAKE", "inf")
    assert(inf[1] == math.huge and inf[2] == -math.huge)
    local big = r:call("FAKE", "big", "3492890328409238509324850943850943825024385")
    assert(math.type(big) == "bigint" and big == 3492890328409238509324850943850943825024385n)
    assert(r:call("FAKE", "true") == true and r:call("FAKE", "false") == false)
    assert(r:call("FAKE", "verbatim", "some text") == "some text")
    assert(same(r:call("FAKE", "set"), { a = true, b = true, [3] = true }))
    local map = r:call("FAKE", "map")
    assert(map.name == "Ada" and map.n == 2 and map.tags.x == true)
    assert(same(map.nested, { k = { 1, 2 } }))
    local nulls = r:call("FAKE", "nulls")
    assert(nulls[1] == "a" and nulls[2] == nil and nulls[3] == "c")
    assert(r:call("FAKE", "attr", "value") == "value")
    -- A push message that arrives before a reply is passed over.
    assert(r:call("FAKE", "push") == "after")
    assert(r:ping() == "PONG")
end

local function binary_test()
    local env <close> = setup()
    local r from env
    -- A reply that is not valid text is a vector.
    local blob = r:call("FAKE", "bytes")
    assert(type(blob) == "vector" and #blob == 4)
    assert(vector.get(blob, 0) == 255 and vector.get(blob, 2) == 254)
    -- A vector argument travels as its bytes.
    assert(r:set("blob", blob) == "OK")
    local back = r:get("blob")
    assert(type(back) == "vector" and #back == 4 and vector.get(back, 3) == 1)
    -- The length of a bulk string counts bytes.
    local text = "h\u{e9}llo \u{1F600}"
    assert(r:set("text", text) == "OK")
    assert(r:get("text") == text)
    assert(r:set("empty", "") == "OK" and r:get("empty") == "")
end

local function large_values_test()
    local env <close> = setup()
    local r from env
    local big = r:call("FAKE", "size", 2500000)
    assert(#big == 2500000 and big:sub(-3) == "xxx")
    local text = string.rep("abcdefghij", 150000)
    assert(r:set("large", text) == "OK")
    assert(r:get("large") == text)
    assert(r:ping() == "PONG")
end

local function errors_test()
    local env <close> = setup()
    local r from env
    r:hset("h", "f", "v")

    local err = failure(function()
        r:get("h")
    end)

    assert(redis.is_error(err))
    assert(err.code == "WRONGTYPE")
    assert(err.message == "WRONGTYPE Operation against a key holding the wrong kind of value")
    assert(tostring(err) == err.message)

    err = failure(function()
        r:nosuchcommand("x")
    end)

    assert(err.code == "ERR" and err.message:find("unknown command", 1, true))

    err = failure(function()
        r:call("FAKE", "bulkerr", "SYNTAX invalid syntax")
    end)

    assert(err.code == "SYNTAX")
    assert(not redis.is_error("ERR text") and not redis.is_error({ code = "ERR" }))
    -- An error reply leaves its connection in the pool.
    assert(r:ping() == "PONG" and env.server.accepted == 1)
end

local function pooled_state_commands_test()
    local env <close> = setup()
    local r from env

    raises(function()
        r:multi()
    end, "use r:transaction")

    raises(function()
        r:watch("k")
    end, "watch option")

    raises(function()
        r:select(1)
    end, "db option")
end

-- Pipelines ----------------------------------------------------------------------

local function pipeline_test()
    local env <close> = setup()
    local r from env
    r:set("a", "1")

    local results = r:pipeline(function(p)
        assert(p:get("a") == nil)
        p:get("missing")
        p:incr("a")
        p:call("HSET", "h", { x = 1 })
        p:hgetall("h")
    end)

    assert(results.n == 5)
    assert(results[1] == "1" and results[2] == nil and results[3] == 2 and results[4] == 1)
    assert(same(results[5], { x = "1" }))

    assert(r:pipeline(function()
    end).n == 0)

    assert(env.server.accepted == 1)
end

local function pipeline_errors_test()
    local env <close> = setup()
    local r from env
    r:hset("h", "f", "v")

    local results = r:pipeline(function(p)
        p:set("k", "v")
        p:incr("h")
        p:get("k")
    end)

    assert(results[1] == "OK" and results[3] == "v")
    assert(redis.is_error(results[2]) and results[2].code == "WRONGTYPE")

    -- An error of the function sends nothing.
    raises(function()
        r:pipeline(function(p)
            p:set("unsent", "1")
            error("stop")
        end)
    end, "stop")

    assert(r:exists("unsent") == 0)
end

local function pipeline_many_test()
    local env <close> = setup()
    local r from env

    local results = r:pipeline(function(p)
        for _ = 1, 500 do
            p:incr("n")
        end
    end)

    assert(results.n == 500 and results[500] == 500 and results[1] == 1)
end

-- Transactions -------------------------------------------------------------------

local function transaction_test()
    local env <close> = setup()
    local r, server from env

    local results = r:transaction(function(tx)
        assert(tx:set("a", "1") == nil)
        tx:incr("a")
        tx:get("a")
    end)

    assert(results.n == 3 and results[1] == "OK" and results[2] == 2 and results[3] == "2")
    assert(count(server.log, "MULTI") == 1 and count(server.log, "EXEC") == 1)

    assert(r:transaction(function()
    end).n == 0)

    assert(count(server.log, "MULTI") == 1)
end

local function transaction_errors_test()
    local env <close> = setup()
    local r from env
    r:hset("h", "f", "v")

    -- A command that fails while the transaction runs has its error in place.
    local results = r:transaction(function(tx)
        tx:set("a", "1")
        tx:incr("h")
        tx:get("a")
    end)

    assert(results[1] == "OK" and results[3] == "1")
    assert(redis.is_error(results[2]) and results[2].code == "WRONGTYPE")

    -- A command that the server refuses to queue cancels the transaction.
    local err = failure(function()
        r:transaction(function(tx)
            tx:set("b", "1")
            tx:nosuchcommand()
        end)
    end)

    assert(redis.is_error(err) and err.message:find("unknown command", 1, true))
    assert(r:exists("b") == 0)

    -- An error of the function sends nothing.
    raises(function()
        r:transaction(function(tx)
            tx:set("c", "1")
            error("stop")
        end)
    end, "stop")

    assert(r:exists("c") == 0 and r:ping() == "PONG")
    assert(env.server.accepted == 1)
end

local function watch_test()
    local env <close> = setup()
    local r, server from env
    r:set("balance", "100")

    local results = r:transaction(function(tx, conn)
        local balance = tonumber(conn:get("balance"))
        tx:set("balance", balance - 10)
    end, { watch = "balance" })

    assert(results[1] == "OK" and r:get("balance") == "90")
    -- A change of the watched key by another connection cancels the transaction.
    local runs = 0

    local aborted = r:transaction(function(tx, conn)
        runs = runs + 1
        local balance = tonumber(conn:get("balance"))
        r:set("balance", "5")
        tx:set("balance", balance - 10)
    end, { watch = { "balance" } })

    assert(aborted == nil and runs == 1 and r:get("balance") == "5")
    -- With retries the function runs again and sees the new value.
    runs = 0

    results = r:transaction(function(tx, conn)
        runs = runs + 1
        local balance = tonumber(conn:get("balance"))

        if runs == 1 then
            r:incr("balance")
        end

        tx:set("balance", balance * 2)
    end, { watch = { "balance" }, retries = 2 })

    assert(runs == 2 and results[1] == "OK" and r:get("balance") == "12")
    assert(server.accepted == 2)
end

local function watch_function_error_test()
    local env <close> = setup()
    local r, server from env
    local bound

    raises(function()
        r:transaction(function(_, conn)
            bound = conn
            error("stop")
        end, { watch = "k" })
    end, "stop")

    assert(count(server.log, "WATCH") == 1 and count(server.log, "UNWATCH") == 1)

    raises(function()
        bound:get("k")
    end, "the transaction has ended")

    -- A function that records nothing releases the keys too.
    assert(r:transaction(function()
    end, { watch = "k" }).n == 0)

    assert(count(server.log, "UNWATCH") == 2 and server.accepted == 1)
end

-- Publish and subscribe -----------------------------------------------------------

-- Sends commands until `done` returns true, which gives the coroutines of
-- the server and of the test their turns.
local function settle(r, done)
    for _ = 1, 200 do
        if done() then
            return
        end

        r:ping()
    end

    error("the condition never held")
end

-- Runs `fn` in a detached coroutine once a connection has subscribed to
-- `name`.
local function when_subscribed(server, field, name, fn)
    return coroutine.detach(coroutine.create(function()
        while not (server[field][name] and next(server[field][name])) do
            coroutine.yield()
        end

        fn()
    end))
end

local function subscribe_test(mode)
    local env <close> = setup({ resp2 = mode == "resp2" })
    local r, server from env

    local publisher = when_subscribed(server, "channels", "b", function()
        assert(r:publish("a", "one") == 1)
        assert(r:publish("c", "nobody") == 0)
        r:publish("b", "two")
        r:publish("a", "stop")
    end)

    local seen = {}

    for channel, message, pattern in r:subscribe("a", "b") do
        seen[#seen + 1] = `$channel=$message`
        assert(pattern == nil)

        if message == "stop" then
            break
        end
    end

    assert(table.concat(seen, " ") == "a=one b=two a=stop")
    assert(coroutine.resume(publisher))

    -- Leaving the loop closed the connection of the subscription.
    settle(r, function()
        return server.open == 1
    end)

    assert(server.accepted == 2)
end

local subscribe_cases = { resp3 = "resp3", resp2 = "resp2" }

local function psubscribe_test()
    local env <close> = setup()
    local r from env
    local next_message, sub = r:psubscribe("news.*")
    assert(r:publish("news.tech", "x") == 1)
    assert(r:publish("other", "y") == 0)
    local channel, message, pattern = next_message(sub)
    assert(channel == "news.tech" and message == "x" and pattern == "news.*")
    sub:close()
    assert(next_message(sub) == nil)
    sub:close()

    raises(function()
        r:subscribe()
    end, "channel expected")

    raises(function()
        r:psubscribe()
    end, "channel expected")
end

local function subscription_changes_test()
    local env <close> = setup()
    local r, server from env
    local next_message, sub = r:subscribe("a")
    sub:subscribe("b")
    sub:psubscribe("p.*")
    assert(r:publish("b", "1") == 1)
    assert(r:publish("p.x", "2") == 1)
    -- Messages that arrive while the server confirms a change wait their turn.
    sub:unsubscribe("a")
    assert(r:publish("a", "lost") == 0)
    local channel, message, pattern = next_message(sub)
    assert(channel == "b" and message == "1" and pattern == nil)
    channel, message, pattern = next_message(sub)
    assert(channel == "p.x" and message == "2" and pattern == "p.*")
    -- A subscription without a channel or a pattern ends its loop.
    sub:punsubscribe()
    sub:unsubscribe()
    assert(next_message(sub) == nil)
    assert(sub.closed)

    local err = failure(function()
        sub:subscribe("z")
    end)

    assert(err.code == "CONNECTION")

    settle(r, function()
        return server.open == 1
    end)
end

local function subscriber_coroutine_test()
    local env <close> = setup()
    local r from env
    local got = {}
    local held

    local consumer = coroutine.detach(coroutine.create(function()
        local next_message, sub = r:subscribe("jobs")
        held = sub

        for _, message in next_message, sub, nil, sub do
            got[#got + 1] = message
        end

        return "ended"
    end))

    settle(r, function()
        return held ~= nil
    end)

    r:publish("jobs", "a")
    r:publish("jobs", "b")

    settle(r, function()
        return #got == 2
    end)

    assert(got[1] == "a" and got[2] == "b")
    -- Closing the subscription from another coroutine ends the loop.
    held:close()
    local ok, result = coroutine.resume(consumer)
    assert(ok and result == "ended")
end

local function subscription_connection_lost_test()
    local env <close> = setup()
    local r, server from env
    local next_message, sub = r:subscribe("a")

    for conn in pairs(server.conns) do
        if next(conn.channels) then
            conn.sock:close()
        end
    end

    local err = failure(function()
        next_message(sub)
    end)

    assert(redis.is_error(err) and err.code == "CONNECTION")
    assert(sub.closed and r:ping() == "PONG")
end

-- Scripts ------------------------------------------------------------------------

local function script_test()
    local env <close> = setup()
    local r, server from env
    local echo = r:script("return ARGV[1]")
    assert(#echo.sha == 40 and echo.sha:find("^%x+$"))
    assert(echo.source == "return ARGV[1]")
    -- The first call finds no script on the server and loads it.
    assert(echo({}, "hello") == "hello")
    assert(server.loads == 1 and count(server.log, "EVALSHA") == 2)
    assert(echo(nil, "again") == "again")
    assert(server.loads == 1 and count(server.log, "EVALSHA") == 3)
    assert(r:script_flush() == "OK")
    assert(echo({}, "reloaded") == "reloaded" and server.loads == 2)
    r:set("k", "v")
    local get = r:script("return redis.call('GET', KEYS[1])")
    assert(get({ "k" }) == "v" and get({ "missing" }) == nil)
    assert(same(r:script("return {KEYS[1], ARGV[1], 7}")({ "k" }, "a"), { "k", "a", 7 }))

    raises(function()
        r:script(42)
    end, "string expected")
end

local function script_errors_test()
    local env <close> = setup()
    local r from env

    local err = failure(function()
        r:script("return redis.error_reply('MYERR boom')")()
    end)

    assert(redis.is_error(err) and err.code == "MYERR" and err.message == "MYERR boom")

    err = failure(function()
        r:script("this is not lua")()
    end)

    assert(err.code == "ERR")
    -- The generic methods send EVAL and EVALSHA as they are.
    assert(r:eval("return ARGV[1]", 0, "direct") == "direct")
    local sha = r:script("return ARGV[1]").sha
    assert(r:evalsha(sha, 0, "by sha") == "by sha")

    err = failure(function()
        r:evalsha(string.rep("0", 40), 0)
    end)

    assert(err.code == "NOSCRIPT")
    assert(#r:script_load("return redis.call('INCR', KEYS[1])") == 40)
end

-- Scans --------------------------------------------------------------------------

local function scan_test()
    local env <close> = setup()
    local r, server from env

    for i = 1, 7 do
        r:set(`user:$i`, i)
    end

    r:set("other", "x")
    local keys = {}

    for key in r:scan({ match = "user:*" }) do
        keys[#keys + 1] = key
    end

    table.sort(keys)
    assert(#keys == 7 and keys[1] == "user:1" and keys[7] == "user:7")
    assert(count(server.log, "SCAN") == 4)
    local n = 0

    for _ in r:scan({ count = 100 }) do
        n = n + 1
    end

    assert(n == 8 and count(server.log, "SCAN") == 5)
end

local function collection_scans_test()
    local env <close> = setup()
    local r from env
    r:sadd("s", "a", "b", "c")
    local members = {}

    for member in r:sscan("s") do
        members[#members + 1] = member
    end

    table.sort(members)
    assert(table.concat(members) == "abc")
    assert(same(r:smembers("s"), { a = true, b = true, c = true }))
    r:hset("h", { a = 1, ab = 2, b = 3, c = 4 })
    local fields = {}

    for field, value in r:hscan("h", { match = "a*" }) do
        fields[field] = value
    end

    assert(same(fields, { a = "1", ab = "2" }))
    fields = {}

    for field, value in r:hscan("h") do
        fields[field] = value
    end

    assert(same(fields, { a = "1", ab = "2", b = "3", c = "4" }))
    r:zadd("z", 1, "one", 2.5, "two", 3, "three")
    local scores = {}

    for member, score in r:zscan("z") do
        scores[member] = score
    end

    assert(same(scores, { one = 1, two = 2.5, three = 3 }))
    assert(r:zscore("z", "two") == 2.5 and r:zscore("z", "none") == nil)

    for _ in r:sscan("none") do
        error("an empty set has no member")
    end
end

-- The pool -----------------------------------------------------------------------

local function pool_reuse_test()
    local env <close> = setup()
    local r, server from env

    for _ = 1, 20 do
        r:incr("n")
    end

    assert(server.accepted == 1 and r.size == 1 and #r.idle == 1)
end

local function pool_test(size)
    local env <close> = setup(nil, { pool = size })
    local r, server from env
    local workers = {}

    for i = 1, 12 do
        workers[i] = coroutine.detach(coroutine.create(function()
            for _ = 1, 5 do
                r:incr("n")
                assert(r:echo(`w$i`) == `w$i`)
            end

            return i
        end))
    end

    for i = 1, 12 do
        local ok, result = coroutine.resume(workers[i])
        assert(ok and result == i, tostring(result))
    end

    assert(r:get("n") == "60")
    assert(server.accepted <= size, `$(server.accepted) connections`)
    assert(size == 1 or server.accepted > 1)
    assert(r.size == server.accepted and #r.idle == r.size)
end

local pool_cases = { one = 1, three = 3, default = 10 }

local function pool_main_waits_test()
    local env <close> = setup(nil, { pool = 1 })
    local r, server from env

    local big = coroutine.detach(coroutine.create(function()
        return #r:call("FAKE", "size", 3000000)
    end))

    -- A turn of the scheduler starts the coroutine, which takes the only
    -- connection.
    coroutine.resume(coroutine.detach(coroutine.create(function()
        coroutine.yield()
    end)))

    assert(#r.idle == 0)
    assert(r:ping() == "PONG")
    local ok, size = coroutine.resume(big)
    assert(ok and size == 3000000)
    assert(server.accepted == 1)
end

-- Runs the detached coroutines until each waits for something.
local function turn()
    coroutine.resume(coroutine.detach(coroutine.create(function()
        for _ = 1, 3 do
            coroutine.yield()
        end
    end)))
end

local function pool_waiters_park_test()
    local env <close> = setup(nil, { pool = 1 })
    local r, server from env
    local order = {}
    local gate = coroutine.sleep(math.huge)
    local before = parks

    local holder = coroutine.detach(coroutine.create(function()
        r:transaction(function()
            coroutine.resume(gate)
        end)

        -- The connection went to the first waiter, so this call joins the
        -- end of the list.
        r:ping()
        order[#order + 1] = "holder"
    end))

    turn()
    assert(#r.idle == 0 and #r.waiters == 0)
    local waiters = {}

    for i = 1, 3 do
        waiters[i] = coroutine.detach(coroutine.create(function()
            assert(r:echo(`w$i`) == `w$i`)
            order[#order + 1] = i
        end))
    end

    turn()
    assert(#r.waiters == 3 and parks == before + 3)
    -- A waiter stays parked while other coroutines run.
    local spins = 0

    coroutine.resume(coroutine.detach(coroutine.create(function()
        for _ = 1, 500 do
            spins = spins + 1
            coroutine.yield()
        end
    end)))

    assert(spins == 500 and #r.waiters == 3 and parks == before + 3)
    assert(#order == 0)
    coroutine.close(gate)
    assert(coroutine.resume(holder))

    for i = 1, 3 do
        coroutine.resume(waiters[i])
    end

    assert(table.concat(order, ",") == "1,2,3,holder", table.concat(order, ","))
    assert(parks == before + 4)
    assert(server.accepted == 1 and r.size == 1 and #r.idle == 1 and #r.waiters == 0)
end

local function pool_plain_coroutine_waits_test()
    local env <close> = setup(nil, { pool = 1 })
    local r, server from env
    local gate = coroutine.sleep(0.02)

    local holder = coroutine.detach(coroutine.create(function()
        r:transaction(function()
            coroutine.resume(gate)
        end)
    end))

    turn()
    assert(#r.idle == 0)
    local before = parks

    local plain = coroutine.wrap(function()
        return r:ping()
    end)

    assert(plain() == "PONG")
    assert(parks == before + 1 and server.accepted == 1)
    assert(coroutine.resume(holder))
    -- The main chunk waits the same way.
    gate = coroutine.sleep(0.02)

    holder = coroutine.detach(coroutine.create(function()
        r:transaction(function()
            coroutine.resume(gate)
        end)
    end))

    turn()
    assert(r:ping() == "PONG" and parks == before + 2 and server.accepted == 1)
end

local function pool_cancelled_waiter_test()
    local env <close> = setup(nil, { pool = 1 })
    local r, server from env
    local gate = coroutine.sleep(math.huge)
    local first, second, third

    local holder = coroutine.detach(coroutine.create(function()
        r:transaction(function()
            coroutine.resume(gate)
        end)

        -- The connection is on its way to the second waiter, which passes
        -- it on when it is cancelled before it runs.
        assert(#r.waiters == 1 and #r.idle == 0)
        coroutine.close(second)
    end))

    turn()
    local got = {}

    first = coroutine.detach(coroutine.create(function()
        got[#got + 1] = "first"
        r:ping()
    end))

    second = coroutine.detach(coroutine.create(function()
        r:ping()
        got[#got + 1] = "second"
    end))

    third = coroutine.detach(coroutine.create(function()
        r:ping()
        got[#got + 1] = "third"
    end))

    turn()
    assert(#r.waiters == 3)
    -- A waiter that is cancelled in its wait leaves the list.
    assert(coroutine.close(first))
    assert(#r.waiters == 2)
    coroutine.close(gate)
    assert(coroutine.resume(holder))
    assert(coroutine.resume(third))
    assert(table.concat(got, ",") == "first,third", table.concat(got, ","))
    assert(server.accepted == 1 and r.size == 1 and #r.idle == 1 and #r.waiters == 0)
end

local function pool_close_wakes_waiters_test()
    local env <close> = setup(nil, { pool = 1 })
    local r from env
    local gate = coroutine.sleep(math.huge)

    local holder = coroutine.detach(coroutine.create(function()
        r:transaction(function()
            coroutine.resume(gate)
        end)
    end))

    turn()

    local waiter = coroutine.detach(coroutine.create(function()
        return r:ping()
    end))

    turn()
    assert(#r.waiters == 1)
    r:close()
    local ok, err = coroutine.resume(waiter)
    assert(not ok and redis.is_error(err) and err.code == "CONNECTION")
    coroutine.close(gate)
    coroutine.resume(holder)
    assert(r.size == 0 and #r.waiters == 0)
end

local function broken_connection_test()
    local env <close> = setup()
    local r, server from env

    local err = failure(function()
        r:call("FAKE", "close")
    end)

    assert(redis.is_error(err) and err.code == "CONNECTION")
    assert(r.size == 0)
    assert(r:ping() == "PONG")
    assert(server.accepted == 2 and r.size == 1)

    err = failure(function()
        r:call("FAKE", "garbage")
    end)

    assert(err.code == "PROTOCOL" and err.message:find("unknown type '?'", 1, true))
    assert(r:ping() == "PONG" and server.accepted == 3 and r.size == 1)
end

