local SERVER_TLS = { server = true, cert = TEST_CERT, key = TEST_KEY }

local function rediss_test()
    local env <close> = setup({ tls = SERVER_TLS, password = "secret" }, {
        tls = { ca = TEST_CA },
        password = "secret",
        timeout = 5,
    })
    local r, server from env
    assert(server.url:find("^rediss://localhost:"))
    assert(r.resp == 3 and r:ping() == "PONG")
    -- A value larger than one TLS record goes both ways.
    local big = string.rep("0123456789abcdef", 8192)
    r:set("big", big)
    assert(r:get("big") == big)

    local replies = r:pipeline(function(p)
        p:incr("n")
        p:incr("n")
    end)

    assert(replies[1] == 1 and replies[2] == 2)
    -- A subscription opens a TLS connection of its own.
    local got = {}

    local listening = coroutine.detach(coroutine.create(function()
        for channel, message in r:subscribe("news") do
            got[#got + 1] = `$channel=$message`

            if message == "last" then
                break
            end
        end
    end))

    settle(r, function()
        return next(server.channels) ~= nil
    end)

    r:publish("news", "first")
    r:publish("news", "last")

    settle(r, function()
        return coroutine.status(listening) == "dead"
    end)

    assert(got[1] == "news=first" and got[2] == "news=last")
    -- The valkeys scheme means the same.
    local other = env:connect(
        { tls = { ca = TEST_CA }, password = "secret" },
        `valkeys://localhost:$(server.port)`
    )
    assert(other:get("n") == "2")
end

local function rediss_certificate_test()
    local env <close> = setup({ tls = SERVER_TLS }, false)
    local url = env.server.url

    -- The authorities of the system do not know the test certificate.
    local err = failure(function()
        env:connect(nil, url)
    end)

    assert(redis.is_error(err) and err.code == "CONNECTION" and err.timeout == nil)
    assert(
        tostring(err):find("certificate verification failed for localhost", 1, true),
        tostring(err)
    )

    err = failure(function()
        env:connect({ tls = { ca = TEST_CA, servername = "other.test" } }, url)
    end)

    assert(
        tostring(err):find("certificate verification failed for other.test", 1, true),
        tostring(err)
    )
    local r = env:connect({ tls = { verify = false } }, `rediss://127.0.0.1:$(env.server.port)`)
    assert(r:ping() == "PONG")
end

-- A server that accepts a connection and never answers.
local function silent_server(body)
    local listener <close> = network.tcp.bind("127.0.0.1", 0)
    local _, port = listener:getsockname()
    local held = {}

    local serving = coroutine.detach(coroutine.create(function()
        while true do
            held[#held + 1] = listener:accept()
        end
    end))

    local ok, err = catch body(port)
    coroutine.close(serving)

    for _, sock in ipairs(held) do
        sock:close()
    end

    if not ok then
        error(err, 0)
    end
end

local function connect_timeout_test()
    silent_server(function(port)
        -- The handshake of TLS and the greeting of the client both wait
        -- for a server that stays silent.
        local start = time.monotonic()

        local err = failure(function()
            redis.connect(`rediss://127.0.0.1:$port`, { timeout = 0.05 })
        end)

        assert(
            redis.is_error(err) and err.code == "CONNECTION" and err.timeout == true,
            tostring(err)
        )
        assert(tostring(err) == "TLS handshake timeout", tostring(err))

        err = failure(function()
            redis.connect(`redis://127.0.0.1:$port`, { timeout = 0.05 })
        end)

        assert(
            err.code == "CONNECTION" and err.timeout == true and tostring(err) == "receive timeout",
            tostring(err)
        )
        assert((time.monotonic() - start):seconds() < 5)
    end)

    -- The timeout reaches the connection itself.
    local connect = network.tcp.connect
    local seen

    network.tcp.connect = function(host, port, options)
        seen = options
        return connect(host, port, options)
    end

    local env <close> = setup(nil, { timeout = 3 })
    network.tcp.connect = connect
    assert(seen?.timeout == 3)
    assert(env.r:ping() == "PONG")
end

local function timeout_test()
    local env <close> = setup(nil, { timeout = 0.05 })
    local r, server from env

    local err = failure(function()
        r:call("FAKE", "silent")
    end)

    assert(redis.is_error(err) and err.code == "CONNECTION" and err.timeout == true)
    assert(err.message == "receive timeout")
    -- The connection with a reply still on its way is closed.
    assert(r.size == 0)
    assert(r:ping() == "PONG" and server.accepted == 2)
end

local function cancelled_command_test()
    local env <close> = setup(nil, { pool = 2 })
    local r from env

    local stuck = coroutine.detach(coroutine.create(function()
        r:call("FAKE", "silent")
    end))

    settle(r, function()
        return r.size == 2
    end)

    coroutine.close(stuck)
    -- The pool drops the connection that still waits for a reply.
    assert(r.size == 1)
    assert(r:ping() == "PONG")
end

-- RESP2 --------------------------------------------------------------------------

local function resp2_fallback_test()
    local env <close> = setup({ resp2 = true })
    local r from env
    assert(r.resp == 2)
    r:hset("h", { a = 1, b = 2 })
    assert(same(r:hgetall("h"), { a = "1", b = "2" }))
    assert(same(r:hgetall("missing"), {}))
    assert(r:get("missing") == nil)
    r:sadd("s", "x", "y")
    assert(same(r:smembers("s"), { x = true, y = true }))
    r:zadd("z", 1.5, "m")
    assert(r:zscore("z", "m") == 1.5 and r:zscore("z", "none") == nil)
    assert(same(r:config_get("maxmemory"), { maxmemory = "0" }))
    assert(same(r:call("hgetall", "h"), { a = "1", b = "2" }))
    local values = r:mget("missing", "also")
    assert(values[1] == nil and values[2] == nil)
    r:set("k", "v")

    local results = r:pipeline(function(p)
        p:hgetall("h")
        p:smembers("s")
        p:get("k")
    end)

    assert(same(results[1], { a = "1", b = "2" }) and results[2].x == true and results[3] == "v")

    results = r:transaction(function(tx)
        tx:hgetall("h")
        tx:incr("n")
    end)

    assert(same(results[1], { a = "1", b = "2" }) and results[2] == 1)

    assert(r:transaction(function(tx)
        r:set("k", "changed")
        tx:get("k")
    end, { watch = "k" }) == nil)
end

local function resp2_auth_test()
    local env <close> = setup({ resp2 = true, password = "pw" }, { password = "pw" })
    assert(env.r.resp == 2 and env.r:ping() == "PONG")

    local err = failure(function()
        env:connect({ password = "wrong" })
    end)

    assert(err.code == "WRONGPASS")
    local named <close> = setup({ resp2 = true, password = "pw", username = "app" }, {
        password = "pw",
        username = "app",
    })
    assert(named.r:ping() == "PONG")
end

local function protocol_option_test()
    local env <close> = setup({ password = "pw" }, {
        protocol = 2,
        password = "pw",
        client_name = "old",
    })
    local r from env
    assert(r.resp == 2)
    r:hset("h", "f", "v")
    assert(same(r:hgetall("h"), { f = "v" }))
    assert(r:client_getname() == "old")
end

-- The store of rate_limit ----------------------------------------------------------

local rate_limit = require("rate_limit")
local web = require("web")

-- A clock that moves the clock of the fake server along.
local function shared_clock(server)
    local clock = { t = 1000000 }

    clock.now = function()
        return clock.t
    end

    function clock:advance(seconds)
        self.t = self.t + seconds
        server.now = server.now + math.floor(seconds * 1000)
    end

    return clock
end

local function rate_store_test()
    local env <close> = setup()
    local r, server from env
    local clock = shared_clock(server)
    local store = redis.rate_limit_store(r)
    local n, reset = store:incr("a", 10)
    assert(n == 1 and reset == 10)
    clock:advance(4)
    n, reset = store:incr("a", 10)
    assert(n == 2 and reset == 6)
    assert(store:incr("a", 10, 5) == 7)
    assert(store:incr("a", 10, -2.5) == 4.5)
    clock:advance(6)
    n, reset = store:incr("a", 10)
    assert(n == 1 and reset == 10)
    assert(server.dbs[0]["rate_limit:a"] ~= nil)
    assert(store:get("missing") == nil)
    store:set("b", 1234.5, 2)
    assert(store:get("b") == 1234.5)
    clock:advance(2)
    assert(store:get("b") == nil)
    -- The scripts load once.
    assert(server.loads == 1)
    local other = redis.rate_limit_store(r, { prefix = "api:" })
    assert(other:incr("a", 10) == 1 and server.dbs[0]["api:a"] ~= nil)
    assert(server.loads == 1)
end

local function rate_store_take_test()
    local env <close> = setup()
    local r, server from env
    local clock = shared_clock(server)
    local store = redis.rate_limit_store(r)
    local allowed, full_in = store:take("k", 2, 1, 3, clock.t)
    assert(allowed == true and full_in == 2)
    allowed, full_in = store:take("k", 2, 1, 3, clock.t)
    assert(allowed == false and full_in == 2)
    assert(store:get("k") == clock.t + 2)
    clock:advance(1)
    allowed, full_in = store:take("k", 2, 1, 3, clock.t)
    assert(allowed == true and full_in == 3)
    -- The key lives until the bucket is full again.
    assert(r:pttl("rate_limit:k") == 3000)
    allowed, full_in = store:take("fraction", 1, 0.25, 2, clock.t + 0.125)
    assert(allowed and full_in == 0.25)
end

local function limiter_on(env, options)
    local clock = shared_clock(env.server)
    options.now = clock.now
    options.store = redis.rate_limit_store(env.r)
    return rate_limit.new(options), clock
end

local function rate_fixed_window_test()
    local env <close> = setup()
    local limiter, clock = limiter_on(env, { max = 3, window = 10 })

    for i = 1, 3 do
        local allowed, info = limiter:check("a")
        assert(allowed)
        assert(info.limit == 3 and info.remaining == 3 - i and info.reset == 10)
        assert(info.retry_after == nil)
    end

    clock:advance(4)
    local allowed, info = limiter:check("a")
    assert(not allowed)
    assert(info.remaining == 0 and info.reset == 6 and info.retry_after == 6)
    assert(limiter:check("b"))
    clock:advance(6)
    allowed, info = limiter:check("a")
    assert(allowed and info.remaining == 2)
end

local function rate_sliding_window_test()
    local env <close> = setup()
    local limiter, clock = limiter_on(env, { max = 10, window = 10, algorithm = "sliding" })

    for i = 1, 10 do
        local allowed, info = limiter:check("a")
        assert(allowed and info.remaining == 10 - i)
    end

    local allowed, info = limiter:check("a")
    assert(not allowed and info.remaining == 0)
    assert(info.retry_after == 10 and info.reset == 10)
    clock:advance(15)

    for _ = 1, 5 do
        assert(limiter:check("a"))
    end

    allowed, info = limiter:check("a")
    assert(not allowed)
    assert(info.retry_after == 1)
    clock:advance(1)
    assert(limiter:check("a"))
end

local function rate_bucket_test()
    local env <close> = setup()
    local limiter, clock = limiter_on(env, {
        max = 10,
        window = 10,
        algorithm = "bucket",
        burst = 3,
    })

    for i = 1, 3 do
        local allowed, info = limiter:check("a")
        assert(allowed and info.limit == 3 and info.remaining == 3 - i)
    end

    local allowed, info = limiter:check("a")
    assert(not allowed and info.remaining == 0 and info.retry_after == 1)
    clock:advance(1)
    allowed, info = limiter:check("a")
    assert(allowed and info.remaining == 0)
    assert(not limiter:check("a"))
    clock:advance(2)
    assert(limiter:check("a"))
    assert(limiter:check("a"))
    assert(not limiter:check("a"))
    clock:advance(1000)
    allowed, info = limiter:check("a")
    assert(allowed and info.remaining == 2)
    -- The limiter takes tokens with the script and never with GET and SET.
    assert(count(env.server.log, "EVALSHA") > 0)
    assert(env.server.script_calls > 0 and count(env.server.log, "GET") == 0)
end

-- Requests that arrive together each take a token of their own.
local function rate_bucket_concurrent_test()
    local env <close> = setup(nil, { pool = 4 })
    local limiter = limiter_on(env, { max = 10, window = 10, algorithm = "bucket", burst = 5 })
    limiter:check("warm")
    local allowed = 0
    local requests = {}

    local function request()
        if limiter:check("k") then
            allowed = allowed + 1
        end
    end

    for i = 1, 20 do
        requests[i] = coroutine.detach(coroutine.create(request))
    end

    for i = 1, 20 do
        assert(coroutine.resume(requests[i]))
    end

    assert(allowed == 5, `$allowed requests passed`)
end

local function rate_web_test()
    local env <close> = setup()
    local clock = shared_clock(env.server)

    local app = web.app({
        log = function()
        end,
    })

    app:register(rate_limit, {
        max = 2,
        window = 60,
        now = clock.now,
        store = redis.rate_limit_store(env.r),
    })

    app:get("/", function()
        return { ok = true }
    end)

    local res = app:inject({ path = "/" })
    assert(res.status == 200 and res.headers["ratelimit-remaining"] == "1")
    assert(res.headers["ratelimit-reset"] == "60")
    app:inject({ path = "/" })
    clock:advance(20)
    res = app:inject({ path = "/" })
    assert(res.status == 429 and res.headers["retry-after"] == "40")
    clock:advance(40)
    assert(app:inject({ path = "/" }).status == 200)
end

-- The store of session -------------------------------------------------------------

local session = require("session")

local function sid_of(res)
    local set = res.headers["set-cookie"]

    if set == nil then
        return nil
    end

    for _, line in ipairs(type(set) == "table" and set or { set }) do
        if pair = line:match("^(sid=[^;]*)") then
            return pair
        end
    end

    return nil
end

local function session_app(env, options)
    local app = web.app()
    options = options or {}
    options.secret = "test secret"
    options.store = redis.session_store(env.r, options.store_options)
    options.store_options = nil
    app:register(session, options)

    app:post("/login", function(req)
        session.regenerate(req)
        req.session.user = "ada"
        return 204
    end)

    app:get("/me", function(req)
        return { user = req.session.user, visits = req.session.visits }
    end)

    app:post("/visit", function(req)
        req.session.visits = (req.session.visits or 0) + 1
        return { visits = req.session.visits }
    end)

    app:post("/logout", function(req)
        session.destroy(req)
        return 204
    end)

    return app
end

local function session_store_test()
    local env <close> = setup()
    local r, server from env
    local store = redis.session_store(r)
    assert(store:get("none") == nil)
    store:set("abc", { user = "ada", roles = { "admin", "dev" } }, 60)
    assert(same(store:get("abc"), { user = "ada", roles = { "admin", "dev" } }))
    assert(r:ttl("session:abc") == 60)
    server.now = server.now + 59000
    assert(store:get("abc").user == "ada")
    server.now = server.now + 1000
    assert(store:get("abc") == nil)
    store:set("abc", { n = 1 }, 60)
    store:destroy("abc")
    store:destroy("abc")
    assert(store:get("abc") == nil and r:dbsize() == 0)
end

local function session_requests_test()
    local env <close> = setup()
    local r, server from env
    local app = session_app(env)
    local pair = sid_of(app:inject({ method = "POST", path = "/login" }))
    assert(pair, "a session cookie")
    assert(r:dbsize() == 1)
    local key = next(server.dbs[0])
    assert(key:find("^session:") and r:ttl(key) == 86400)
    assert(app:inject({ path = "/me", headers = { Cookie = pair } }):json().user == "ada")
    local res = app:inject({ method = "POST", path = "/visit", headers = { Cookie = pair } })
    assert(res:json().visits == 1)
    res = app:inject({ method = "POST", path = "/visit", headers = { Cookie = pair } })
    assert(res:json().visits == 2)
    local me = app:inject({ path = "/me", headers = { Cookie = pair } }):json()
    assert(me.user == "ada" and me.visits == 2)
    -- A request without the cookie has a session of its own.
    assert(app:inject({ path = "/me" }):json().user == nil)
    assert(
        app:inject({ method = "POST", path = "/logout", headers = { Cookie = pair } }).status == 204
    )
    assert(r:dbsize() == 0)
    assert(app:inject({ path = "/me", headers = { Cookie = pair } }):json().user == nil)
end

local function session_expiry_test()
    local env <close> = setup()
    local r, server from env
    local app = session_app(env, { ttl = 120, store_options = { prefix = "sess:" } })
    local pair = sid_of(app:inject({ method = "POST", path = "/login" }))
    assert(next(server.dbs[0]):find("^sess:"))
    server.now = server.now + 119000
    assert(app:inject({ path = "/me", headers = { Cookie = pair } }):json().user == "ada")
    server.now = server.now + 1000
    assert(app:inject({ path = "/me", headers = { Cookie = pair } }):json().user == nil)
    assert(r:dbsize() == 0)
end

-- A handler inside a detached coroutine reads its session while others run.
local function session_concurrent_test()
    local env <close> = setup(nil, { pool = 3 })
    local app = session_app(env)
    local requests = {}

    local function visit_twice()
        local pair = sid_of(app:inject({ method = "POST", path = "/visit" }))
        local res = app:inject({ method = "POST", path = "/visit", headers = { Cookie = pair } })
        return res:json().visits
    end

    for i = 1, 8 do
        requests[i] = coroutine.detach(coroutine.create(visit_twice))
    end

    for i = 1, 8 do
        local ok, visits = coroutine.resume(requests[i])
        assert(ok and visits == 2, tostring(visits))
    end

    assert(env.r:dbsize() == 8)
end

-- The store of queue ---------------------------------------------------------------

local queue = require("queue")

-- A clock that the test moves by hand.
local function fake_time(start)
    local state = { now = start or 1000 }

    state.clock = function()
        return state.now
    end

    state.sleep = function(seconds)
        state.now = state.now + seconds
    end

    return state
end

local function open_queue(env, options)
    local f = fake_time()
    options = options or {}
    options.store = redis.queue_store(env.r)
    options.clock = f.clock
    options.sleep = f.sleep
    return queue.new("jobs", options), f
end

local function queue_add_and_drain_test(mode)
    local env <close> = setup({ resp2 = mode == "resp2" })
    local q <close> = open_queue(env)
    local seen = {}
    local id, created = q:add({ to = "ada@example.com", tags = { "a", "b" } })
    assert(type(id) == "string" and #id == 26 and created == true)
    q:add("text")
    q:add(42)
    assert(same(q:stats(), { waiting = 3, delayed = 0, active = 0, completed = 0, failed = 0 }))

    local n = q:drain(function(job)
        seen[#seen + 1] = job
        assert(q:stats().active == 1)
    end)

    assert(n == 3)
    assert(
        seen[1].id == id
            and seen[1].name == "jobs"
            and seen[1].attempts == 1
            and seen[1].max_attempts == 3
    )
    assert(seen[1].priority == 0 and seen[1].created_at == 1000)
    assert(same(seen[1].data, { to = "ada@example.com", tags = { "a", "b" } }))
    assert(seen[2].data == "text" and seen[3].data == 42)
    assert(same(q:stats(), { waiting = 0, delayed = 0, active = 0, completed = 3, failed = 0 }))

    assert(q:drain(function()
        error("no job is due")
    end) == 0)

    local job = q:get(id)
    assert(
        job.status == "completed"
            and job.attempts == 1
            and job.finished_at == 1000
            and job.error == nil
    )
end

local queue_add_and_drain_cases = { resp3 = "resp3", resp2 = "resp2" }

local function queue_delay_test()
    local env <close> = setup()
    local q <close>, f = open_queue(env)
    local seen = {}

    local function handler(job)
        seen[#seen + 1] = job.data
    end

    q:add("later", { delay = 60 })
    q:add("soon", { delay = 10 })
    q:add("now")
    assert(same(q:stats(), { waiting = 1, delayed = 2, active = 0, completed = 0, failed = 0 }))
    assert(q:drain(handler) == 1)
    f.now = f.now + 9.999
    assert(q:drain(handler) == 0)
    f.now = f.now + 0.001
    assert(q:drain(handler) == 1)
    f.now = f.now + 50
    assert(q:drain(handler) == 1)
    assert(table.concat(seen, ",") == "now,soon,later")
end

local function queue_priority_test()
    local env <close> = setup()
    local q <close>, f = open_queue(env)
    local seen = {}
    q:add("low-1")
    q:add("high-1", { priority = 10 })
    q:add("low-2")
    q:add("high-2", { priority = 10 })
    q:add("negative", { priority = -1 })
    q:add("high-late", { priority = 10, delay = 5 })

    q:drain(function(job)
        seen[#seen + 1] = job.data
    end)

    assert(table.concat(seen, ",") == "high-1,high-2,low-1,low-2,negative")
    f.now = f.now + 5
    q:add("low-3")

    q:drain(function(job)
        seen[#seen + 1] = job.data
    end)

    assert(seen[6] == "high-late" and seen[7] == "low-3")
end

local function queue_idempotent_id_test()
    local env <close> = setup()
    local q <close> = open_queue(env)
    local id, created = q:add({ n = 1 }, { id = "invoice-7" })
    assert(id == "invoice-7" and created == true)
    id, created = q:add({ n = 2 }, { id = "invoice-7" })
    assert(id == "invoice-7" and created == false)
    assert(q:stats().waiting == 1)
    local data

    assert(q:drain(function(job)
        data = job.data
    end) == 1)

    assert(data.n == 1)
    assert(select(2, q:add({ n = 3 }, { id = "invoice-7" })) == false)
    assert(q:clean() == 1)
    assert(select(2, q:add({ n = 4 }, { id = "invoice-7" })) == true)
    assert(q:add("x", { id = 99 }) == "99")
end

local function queue_retry_backoff_test()
    local env <close> = setup()
    local q <close>, f = open_queue(env, { attempts = 4, backoff = 2 })
    local attempts = {}

    local function handler(job)
        attempts[#attempts + 1] = `$(job.attempts)@$(f.now)`

        if job.attempts < 4 then
            error("try again", 0)
        end
    end

    local id = q:add("flaky")
    assert(q:drain(handler) == 1)
    local job = q:get(id)
    assert(
        job.status == "waiting"
            and job.attempts == 1
            and job.error == "try again"
            and job.run_at == 1002
    )
    assert(same(q:stats(), { waiting = 0, delayed = 1, active = 0, completed = 0, failed = 0 }))
    f.now = 1001
    assert(q:drain(handler) == 0)
    f.now = 1002
    assert(q:drain(handler) == 1)
    f.now = 1005
    assert(q:drain(handler) == 0)
    f.now = 1006
    assert(q:drain(handler) == 1)
    f.now = 1014
    assert(q:drain(handler) == 1)
    assert(table.concat(attempts, " ") == "1@1000 2@1002 3@1006 4@1014")
    job = q:get(id)
    assert(job.status == "completed" and job.attempts == 4 and job.finished_at == 1014)
    assert(job.error == "try again")
end

local function queue_failed_and_retry_test()
    local env <close> = setup()
    local q <close>, f = open_queue(env, { attempts = 1 })
    local a = q:add("a")
    q:add("b")
    q:add("c")

    q:drain(function(job)
        if job.data ~= "c" then
            error("down", 0)
        end
    end)

    assert(q:stats().failed == 2 and q:stats().completed == 1)
    local failed = q:get(a)
    assert(failed.status == "failed" and failed.attempts == 1 and failed.finished_at == 1000)
    f.now = f.now + 100

    assert(q:drain(function()
        error("a failed job never runs")
    end) == 0)

    assert(q:retry_failed() == 2)
    assert(same(q:stats(), { waiting = 2, delayed = 0, active = 0, completed = 1, failed = 0 }))
    local job = q:get(a)
    assert(
        job.status == "waiting"
            and job.attempts == 0
            and job.error == "down"
            and job.finished_at == nil
    )
    local seen = {}

    assert(q:drain(function(j)
        seen[#seen + 1] = j.data .. j.attempts
    end) == 2)

    assert(table.concat(seen, ",") == "a1,b1")
    assert(q:retry_failed() == 0)
end

local function queue_clean_test()
    local env <close> = setup()
    local q <close>, f = open_queue(env, { attempts = 1 })
    q:add("old-ok")
    q:add("old-bad")

    q:drain(function(job)
        if job.data == "old-bad" then
            error("bad", 0)
        end
    end)

    f.now = f.now + 100
    q:add("new-ok")
    q:add("pending", { delay = 1000 })

    q:drain(function()
    end)

    assert(q:clean("completed", 50) == 1)
    assert(q:stats().completed == 1)
    assert(q:clean("failed", 200) == 0)
    assert(q:clean("failed") == 1)
    assert(q:clean() == 1)
    assert(same(q:stats(), { waiting = 0, delayed = 1, active = 0, completed = 0, failed = 0 }))
    -- Only the pending job and the counter of the queue remain.
    assert(env.r:dbsize() == 3)
end

local function queue_remove_on_complete_test()
    local env <close> = setup()
    local q <close> = open_queue(env, { remove_on_complete = true })
    local id = q:add("x")

    q:drain(function()
    end)

    assert(q:get(id) == nil)
    assert(q:stats().completed == 0)
    assert(q:get("missing") == nil)
end

local function queues_share_a_store_test()
    local env <close> = setup()
    local store = redis.queue_store(env.r, { prefix = "work:" })
    local f = fake_time()
    local a = queue.new("a", { store = store, clock = f.clock })
    local b = queue.new("b", { store = store, clock = f.clock })
    a:add("for-a", { id = "same" })
    assert(select(2, b:add("for-b", { id = "same" })) == true)
    local seen = {}

    assert(b:drain(function(job)
        seen[#seen + 1] = `$(job.name):$(job.data)`
    end) == 1)

    assert(a:stats().waiting == 1 and b:stats().completed == 1)

    assert(a:drain(function(job)
        seen[#seen + 1] = `$(job.name):$(job.data)`
    end) == 1)

    assert(table.concat(seen, ",") == "b:for-b,a:for-a")
    a:close()
    b:close()
    -- Closing a queue leaves the client of its store open.
    assert(store:stats("a", 0).completed == 1)
    assert(env.server.dbs[0]["work:{a}:job:same"] ~= nil)
    store:close()
    assert(env.r:ping() == "PONG")
end

-- A job whose worker died stays active until its lease ends, then runs again.
local function queue_lease_test()
    local env <close> = setup()
    local store = redis.queue_store(env.r)
    local f = fake_time()
    local q = queue.new("jobs", { store = store, clock = f.clock, lease = 30, attempts = 2 })
    local id = q:add("x")
    local first = store:claim("jobs", 1000000, 1030000)
    assert(first.id == id and first.attempts == 1)
    assert(store:claim("jobs", 1000000, 1030000) == nil)
    assert(q:get(id).status == "active" and q:get(id).run_at == 1030)
    assert(store:next_at("jobs") == 1030000)
    f.now = 1029

    assert(q:drain(function()
    end) == 0)

    f.now = 1030
    local attempts

    assert(q:drain(function(job)
        attempts = job.attempts
    end) == 1)

    assert(attempts == 2 and q:get(id).status == "completed")
    -- The first worker lost the job, so its late answers change nothing.
    assert(store:complete("jobs", id, 1, 1031000, true) == false)
    assert(store:fail("jobs", id, 1, "late", 1031000, nil) == false)
    assert(q:get(id).status == "completed" and q:get(id).error == nil)
    -- A job that stalls in its last attempt fails.
    local id2 = q:add("y", { attempts = 1 })
    assert(store:claim("jobs", 1030000, 1060000).id == id2)
    f.now = 1061

    assert(q:drain(function()
        error("never runs")
    end) == 0)

    assert(
        q:get(id2).status == "failed" and q:get(id2).error == "the job stalled in its last attempt"
    )
    q:close()
end

local function queue_store_claim_order_test()
    local env <close> = setup()
    local store = redis.queue_store(env.r)

    local function job(id, priority, run_at)
        return {
            id = id,
            data = "null",
            priority = priority,
            max_attempts = 1,
            run_at = run_at,
            created_at = 0,
        }
    end

    assert(store:next_at("q") == nil)
    assert(store:add("q", job("late", 0, 500)) == true)
    assert(store:add("q", job("early", 0, 100)) == true)
    assert(store:add("q", job("urgent", 5, 400)) == true)
    assert(store:add("q", job("early", 9, 0)) == false)
    assert(store:next_at("q") == 100)
    assert(store:claim("q", 99, 1000) == nil)
    local urgent = store:claim("q", 450, 9000)
    assert(same(urgent, {
        id = "urgent",
        data = "null",
        attempts = 1,
        max_attempts = 1,
        priority = 5,
        created_at = 0,
    }))
    assert(store:claim("q", 450, 9000).id == "early")
    assert(store:claim("q", 450, 9000) == nil)
    assert(store:claim("q", 500, 9000).id == "late")
    assert(same(store:stats("q", 500), {
        waiting = 0,
        delayed = 0,
        active = 3,
        completed = 0,
        failed = 0,
    }))
    assert(store:fail("q", "late", 1, "oops", 600, 700) == true)
    assert(
        store:get("q", "late").status == "waiting" and store:get("q", "late").last_error == "oops"
    )
    assert(store:next_at("q") == 700)
    assert(store:complete("q", "urgent", 1, 600, false) == true)
    assert(store:complete("q", "urgent", 1, 600, false) == false)
    assert(store:get("q", "urgent").finished_at == 600)
    assert(store:get("q", "urgent").seq == nil)
    assert(store:clean("q", "completed", 599) == 0 and store:clean("q", "completed", 600) == 1)
    assert(store:clean("q", "waiting", 10000) == 0)
    assert(store:get("q", "urgent") == nil)
end

-- A job whose lease ran out stays active, and its first worker may still
-- finish it, until another worker claims it.
local function queue_stale_lease_test()
    local env <close> = setup()
    local store = redis.queue_store(env.r)

    local function job(id, priority)
        return {
            id = id,
            data = "null",
            priority = priority,
            max_attempts = 3,
            run_at = 0,
            created_at = 0,
        }
    end

    store:add("q", job("a", 0))
    store:add("q", job("b", 1))
    store:add("q", job("c", 0))
    assert(store:claim("q", 10, 100).id == "b")
    assert(store:claim("q", 10, 100).id == "a")
    -- Both leases ran out. The claim takes `b` again and leaves `a` due.
    local again = store:claim("q", 200, 300)
    assert(again.id == "b" and again.attempts == 2)
    assert(same(store:stats("q", 200), {
        waiting = 1,
        delayed = 0,
        active = 2,
        completed = 0,
        failed = 0,
    }))
    assert(store:get("q", "a").status == "active")
    assert(store:next_at("q") == 0)
    -- The first worker of `a` finishes late, before anyone claimed the job again.
    assert(store:complete("q", "a", 1, 210, false) == true)
    assert(same(store:stats("q", 210), {
        waiting = 1,
        delayed = 0,
        active = 1,
        completed = 1,
        failed = 0,
    }))
    assert(store:claim("q", 210, 300).id == "c")
    assert(store:claim("q", 210, 300) == nil)
    -- The first worker of `b` lost the job to the second.
    assert(store:fail("q", "b", 1, "late", 220, 500) == false)
    assert(store:fail("q", "b", 2, "again", 220, 500) == true)
    assert(same(store:stats("q", 220), {
        waiting = 0,
        delayed = 1,
        active = 1,
        completed = 1,
        failed = 0,
    }))
    assert(store:next_at("q") == 300)
end

local function queue_many_jobs_test()
    local env <close> = setup()
    local q <close>, f = open_queue(env)

    for i = 1, 120 do
        q:add(i, { priority = i % 3, delay = i % 2 })
    end

    local seen = {}

    assert(q:drain(function(job)
        seen[#seen + 1] = job.data
    end) == 60)

    f.now = f.now + 1

    assert(q:drain(function(job)
        seen[#seen + 1] = job.data
    end) == 60)

    -- The even numbers were due first, by falling priority, then in the order of adding.
    assert(seen[1] == 2 and seen[2] == 8 and seen[21] == 4 and seen[41] == 6 and seen[61] == 5)
    local marks = {}

    for _, v in ipairs(seen) do
        assert(not marks[v])
        marks[v] = true
    end
end

-- Workers that claim at the same time never receive the same job.
local function queue_concurrent_claims_test()
    local env <close> = setup(nil, { pool = 4 })
    local store = redis.queue_store(env.r)

    for i = 1, 40 do
        store:add("q", {
            id = `job-$i`,
            data = "null",
            priority = 0,
            max_attempts = 1,
            run_at = 0,
            created_at = 0,
        })
    end

    local taken, total = {}, 0
    local workers = {}

    local function work()
        while true do
            local job = store:claim("q", 10, 1000)

            if job == nil then
                return
            end

            assert(not taken[job.id], job.id)
            taken[job.id] = true
            total = total + 1
            assert(store:complete("q", job.id, job.attempts, 20, false))
        end
    end

    for w = 1, 6 do
        workers[w] = coroutine.detach(coroutine.create(work))
    end

    for w = 1, 6 do
        assert(coroutine.resume(workers[w]))
    end

    assert(total == 40 and store:stats("q", 20).completed == 40)
end

-- Workers of `q:process` run jobs from the Redis store.
local function queue_process_test()
    local env <close> = setup(nil, { pool = 4 })
    local done = {}
    local q

    q = queue.new("jobs", {
        store = redis.queue_store(env.r),
        concurrency = 3,
        sleep = function()
            env.r:ping()
        end,
    })

    for i = 1, 9 do
        q:add(i)
    end

    q:process(function(job)
        env.r:incr("handled")
        done[#done + 1] = job.data
    end)

    settle(env.r, function()
        return #done == 9
    end)

    q:close()
    assert(env.r:get("handled") == "9" and q:stats().completed == 9)
end

-- A real server --------------------------------------------------------------------

-- The last tests run when LUS_TEST_REDIS holds the URL of a Redis or
-- Valkey server, such as redis://127.0.0.1:6379/15. They write keys that
-- start with `atmos-test:` and delete them.

local function real()
    local ok, url = catch os.getenv("LUS_TEST_REDIS")

    if not ok or url == nil or url == "" then
        skip("LUS_TEST_REDIS is not set")
    end

    local r = redis.connect(url)

    for key in r:scan({ match = "atmos-test:*", count = 1000 }) do
        r:del(key)
    end

    return r
end

local function real_commands_test()
    local r <close> = real()
    assert(r:set("atmos-test:k", "v", { ex = 60 }) == "OK")
    assert(r:get("atmos-test:k") == "v" and r:ttl("atmos-test:k") > 0)
    r:hset("atmos-test:h", { a = 1, b = 2 })
    assert(same(r:hgetall("atmos-test:h"), { a = "1", b = "2" }))
    r:sadd("atmos-test:s", "x", "y")
    assert(same(r:smembers("atmos-test:s"), { x = true, y = true }))
    r:zadd("atmos-test:z", 1.5, "m")
    assert(r:zscore("atmos-test:z", "m") == 1.5)

    local results = r:pipeline(function(p)
        p:incr("atmos-test:n")
        p:incr("atmos-test:h")
    end)

    assert(results[1] == 1 and redis.is_error(results[2]) and results[2].code == "WRONGTYPE")

    results = r:transaction(function(tx, conn)
        tx:set("atmos-test:n", tonumber(conn:get("atmos-test:n")) + 1)
    end, { watch = "atmos-test:n" })

    assert(results[1] == "OK" and r:get("atmos-test:n") == "2")
    local echo = r:script("return ARGV[1]")
    assert(echo({}, "x") == "x")
    local next_message, sub = r:subscribe("atmos-test:channel")
    r:publish("atmos-test:channel", "hello")
    local channel, message = next_message(sub)
    assert(channel == "atmos-test:channel" and message == "hello")
    sub:close()
end

local function real_stores_test()
    local r <close> = real()
    local rates = redis.rate_limit_store(r, { prefix = "atmos-test:rate:" })
    local n, reset = rates:incr("a", 10)
    assert(n == 1 and reset > 9 and reset <= 10)
    assert(rates:incr("a", 10, 2.5) == 3.5)
    local allowed, full_in = rates:take("k", 2, 1, 3, 1000)
    assert(allowed == true and full_in == 2)
    allowed, full_in = rates:take("k", 2, 1, 3, 1000)
    assert(allowed == false and full_in == 2)
    assert(rates:get("k") == 1002)
    local sessions = redis.session_store(r, { prefix = "atmos-test:session:" })
    sessions:set("id", { user = "ada" }, 60)
    assert(sessions:get("id").user == "ada")
    sessions:destroy("id")
    assert(sessions:get("id") == nil)
    local store = redis.queue_store(r, { prefix = "atmos-test:queue:" })

    local function job(id, priority, run_at)
        return {
            id = id,
            data = "null",
            priority = priority,
            max_attempts = 2,
            run_at = run_at,
            created_at = 0,
        }
    end

    assert(store:next_at("q") == nil)
    assert(store:add("q", job("late", 0, 500)) and store:add("q", job("early", 0, 100)))
    assert(store:add("q", job("urgent", 5, 400)) and not store:add("q", job("early", 9, 0)))
    assert(store:next_at("q") == 100)
    assert(store:claim("q", 99, 1000) == nil)
    assert(store:claim("q", 450, 9000).id == "urgent")
    assert(store:claim("q", 450, 9000).id == "early")
    assert(store:claim("q", 500, 9000).id == "late")
    assert(same(store:stats("q", 500), {
        waiting = 0,
        delayed = 0,
        active = 3,
        completed = 0,
        failed = 0,
    }))
    assert(store:fail("q", "late", 1, "oops", 600, 700) == true)
    assert(store:get("q", "late").last_error == "oops" and store:next_at("q") == 700)
    assert(store:complete("q", "urgent", 1, 600, false) == true)
    assert(store:complete("q", "urgent", 1, 600, false) == false)
    assert(store:fail("q", "early", 1, "gone", 650, nil) == true)
    assert(store:retry_failed("q", 660) == 1)
    assert(store:claim("q", 9500, 9900).attempts == 1)
    assert(store:clean("q", "completed", 600) == 1)

    for key in r:scan({ match = "atmos-test:*", count = 1000 }) do
        r:del(key)
    end
end

-- A command returns exactly one value, also under RESP2 where the reply is
-- reshaped inside a function that holds a <close> connection.
local function call_returns_one_value_test()
    local env <close> = setup(nil, { protocol = 2 })
    local r from env
    r:hset("h", { a = 1 })
    assert(select("#", r:hgetall("h")) == 1)
    assert(select("#", r:get("missing")) == 1)
end
