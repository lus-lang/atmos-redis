--- Talks to Redis and Valkey servers in the RESP3 protocol.
---
--- `redis.connect` returns a client that keeps a pool of connections. Every
--- command of the server is a method of the client, named after the command
--- in lowercase, so `r:set("k", "v", { ex = 60 })` sends `SET k v ex 60`. An
--- underscore separates the words of a command of several words, as in
--- `r:config_get("maxmemory")`. `r:call` sends a command whose name is
--- chosen at run time.
---
--- An argument is a string, a number, a boolean, a vector, or a table. A
--- number is sent as its text, a boolean as `1` or `0`, and a vector as its
--- bytes. A table expands in place. Its array items come first. Each named
--- field follows as its name and its value, in the sorted order of the
--- names. A field whose value is `true` adds its name alone, which is how a
--- flag such as `nx` is written. A field whose value is `false` adds
--- nothing. The same rule sends a table of fields to `HSET`, as in
--- `r:hset("user:1", { name = "Ada", age = 36 })`. A nil argument raises an
--- error.
---
--- A reply becomes a Lus value. A bulk string is a string, or a vector when
--- its bytes are not valid text. An integer is an integer, a double is a
--- float, a big number is a bigint, and a boolean is a boolean. An array is
--- a table with the items at 1 and up, a map is a table from keys to values,
--- and a set is a table whose keys are the members and whose values are
--- `true`. A null is nil, so an array that contains a null has a gap at
--- that position.
---
--- An error reply raises an error object, which is a table with the fields
--- `message`, the text of the server, and `code`, the first word of that
--- text, such as `"WRONGTYPE"` or `"NOSCRIPT"`. `tostring` returns the
--- message. A connection that fails raises an error object with the code
--- `"CONNECTION"`, whose `timeout` field is `true` when a wait ran out of
--- time. A reply that breaks the protocol raises one with the
--- code `"PROTOCOL"`. `redis.is_error` recognizes these objects, which
--- pipelines and transactions return in place of the reply of a command that
--- failed.
---
--- Every call waits on a socket, so inside a detached coroutine it suspends
--- that coroutine while the others run. Each coroutine that sends a command
--- takes a connection from the pool for the length of that command. When
--- every connection is taken, the caller waits until one returns. Waiting
--- callers receive connections in the order of their arrival.
---
--- The client opens a connection with `HELLO 3`. A server that lacks the
--- command keeps the RESP2 protocol, in which the client converts the
--- replies of `HGETALL`, `CONFIG GET`, `SMEMBERS`, `SINTER`, `SUNION`,
--- `SDIFF`, `ZSCORE`, and `ZINCRBY` to the values that RESP3 gives.
---
--- `redis.rate_limit_store`, `redis.session_store`, and `redis.queue_store`
--- return the stores that the `rate_limit`, `session`, and `queue` packages
--- accept.
---
--- @package redis
--- @version 1.0.0
--- @lus 2.0
--- @license 0BSD
--- @repository https://github.com/lus-lang/atmos-redis
--- @permission network:tcp Connects to the Redis server that `redis.connect` names.

local M = {}

local type, tostring, tonumber, select, pairs, error = type, tostring, tonumber, select, pairs, error
local setmetatable, getmetatable = setmetatable, getmetatable
local concat, sort from table
local byte, sub, find, upper, format, match, gmatch from string
local floor, ceil, max_of, math_type = math.floor, math.ceil, math.max, math.type
local v_tostring, v_fromstring, v_create, v_copy = vector.tostring, vector.fromstring, vector.create, vector.copy
local create, detach, resume, close, sleep from coroutine

-- Errors ------------------------------------------------------------------------

local Error = {}
Error.__index = Error
Error.__name = "redis.error"
Error.__tostring = function(e) return e.message end

local function new_error(code, message)
    return setmetatable({ code = code, message = message }, Error)
end

local function server_error(text)
    return new_error(match(text, "^[A-Z][A-Z0-9_-]*") or "ERR", text)
end

--- Tells whether a value is an error object of the package.
---
--- Pipelines and transactions return the error of a command in the position
--- of its reply. The call separates such an error from a reply.
--- @param value any The value to test.
--- @return boolean True when `value` is an error object that the package made.
function M.is_error(value)
    return getmetatable(value) == Error
end

-- Requests ----------------------------------------------------------------------

local NON_ASCII = "[^\0-\x7f]"
local EMPTY = {}

local function number_text(a)
    if math_type(a) ~= "float" then
        return tostring(a)
    end
    if a ~= a then
        error("cannot send NaN to Redis", 0)
    end
    if a == math.huge then
        return "inf"
    elseif a == -math.huge then
        return "-inf"
    elseif a == floor(a) and a > -1e15 and a < 1e15 then
        return format("%.0f", a)
    end
    return format("%.17g", a)
end

-- Appends the arguments that `a` stands for to `flat` and returns the new
-- count.
local function flatten(flat, n, a)
    local t = type(a)
    if t == "string" or t == "vector" then
        n = n + 1
        flat[n] = a
    elseif t == "number" then
        n = n + 1
        flat[n] = number_text(a)
    elseif t == "table" then
        local len = #a
        for i = 1, len do
            n = flatten(flat, n, a[i])
        end
        local names, count = nil, 0
        for k in pairs(a) do
            if type(k) == "string" then
                names = names or {}
                count = count + 1
                names[count] = k
            elseif math_type(k) ~= "integer" or k < 1 or k > len then
                error(`cannot send a table with the key $(tostring(k)) to Redis`, 0)
            end
        end
        if count > 1 then
            sort(names)
        end
        for i = 1, count do
            local name = names[i]
            local value = a[name]
            if value == true then
                n = n + 1
                flat[n] = name
            elseif value ~= false then
                n = n + 1
                flat[n] = name
                n = flatten(flat, n, value)
            end
        end
    elseif t == "boolean" then
        n = n + 1
        flat[n] = a and "1" or "0"
    else
        error(`cannot send a $t value to Redis`, 0)
    end
    return n
end

-- Flattens the arguments of a command into a list of strings and vectors.
local function collect(...)
    local flat, n = {}, 0
    for i = 1, select("#", ...) do
        local a = select(i, ...)
        if a == nil then
            error(`argument #$i of the Redis command is nil`, 0)
        end
        n = flatten(flat, n, a)
    end
    if n == 0 then
        error("a Redis command needs a name", 0)
    end
    return flat, n
end

-- Encodes a command as an array of bulk strings. The result is a string, or
-- a list of strings and vectors when an argument is a vector.
local function encode(flat, n)
    local parts = { `*$n\r\n` }
    local count, binary = 1, false
    for i = 1, n do
        local a = flat[i]
        if type(a) == "string" then
            local len = #a
            if find(a, NON_ASCII) then
                len = #v_fromstring(a)
            end
            count = count + 1
            parts[count] = `\$$len\r\n$a\r\n`
        else
            binary = true
            parts[count + 1] = `\$$(#a)\r\n`
            parts[count + 2] = a
            parts[count + 3] = "\r\n"
            count = count + 3
        end
    end
    if binary then
        return parts
    end
    return concat(parts)
end

-- Connections -------------------------------------------------------------------

-- The second result of `read` for an error reply and for a push message.
local ERR, PUSH = 1, 2

-- Returns the error object for a failure of the socket. `cause` is the
-- error object of the socket, whose code "timeout" sets the `timeout` field.
local function socket_error(cause)
    local err = new_error("CONNECTION", tostring(cause))
    if type(cause) == "table" and cause.code == "timeout" then
        err.timeout = true
    end
    return err
end

-- Marks the connection as broken and raises an error object. `cause` is a
-- message, or the error object of a failed socket operation.
local function fail(conn, code, cause)
    conn.broken = true
    if type(cause) == "string" then
        error(new_error(code, cause), 0)
    end
    error(socket_error(cause), 0)
end

local function send(conn, payload)
    local sock = conn.sock
    if type(payload) == "string" then
        local sent, err = sock:send(payload)
        if sent == nil then
            fail(conn, "CONNECTION", err)
        end
        return
    end
    -- Adjacent strings travel in one write.
    local pending, count = {}, 0
    for i = 1, #payload do
        local part = payload[i]
        if type(part) == "table" then
            if count > 0 then
                send(conn, concat(pending, "", 1, count))
                count = 0
            end
            send(conn, part)
        elseif type(part) == "string" then
            count = count + 1
            pending[count] = part
        else
            if count > 0 then
                send(conn, concat(pending, "", 1, count))
                count = 0
            end
            local sent, err = sock:send(part)
            if sent == nil then
                fail(conn, "CONNECTION", err)
            end
        end
    end
    if count > 0 then
        send(conn, concat(pending, "", 1, count))
    end
end

local function read_line(conn)
    local line, err = conn.sock:receive("*l")
    if line == nil then
        fail(conn, "CONNECTION", err)
    end
    if #line == 0 then
        fail(conn, "CONNECTION", "the server closed the connection")
    end
    return v_tostring(line, 0, #line, "lossy")
end

local CHUNK = 1 << 20

-- Reads a bulk payload of `n` bytes and its line end.
local function read_bulk(conn, n)
    local sock = conn.sock
    local data
    if n + 2 <= CHUNK then
        local err
        data, err = sock:receive(n + 2)
        if data == nil then
            fail(conn, "CONNECTION", err)
        end
        if #data < n + 2 then
            fail(conn, "CONNECTION", "the server closed the connection")
        end
    else
        data = v_create(n)
        local at = 0
        while at < n + 2 do
            local want = n + 2 - at
            if want > CHUNK then
                want = CHUNK
            end
            local part, err = sock:receive(want)
            if part == nil then
                fail(conn, "CONNECTION", err)
            end
            if #part < want then
                fail(conn, "CONNECTION", "the server closed the connection")
            end
            local keep = #part
            if at + keep > n then
                keep = n - at
            end
            if keep > 0 then
                v_copy(data, at, part, 0, keep)
            end
            at = at + want
        end
    end
    local ok, text = catch v_tostring(data, 0, n)
    if ok then
        return text
    end
    if #data ~= n then
        local bytes = v_create(n)
        if n > 0 then
            v_copy(bytes, 0, data, 0, n)
        end
        return bytes
    end
    return data
end

local function count_of(conn, rest)
    local n = tonumber(rest)
    if math_type(n) ~= "integer" then
        fail(conn, "PROTOCOL", `the reply has the invalid length '$rest'`)
    end
    return n
end

-- Reads one reply. The second result is ERR when the reply is an error,
-- whose object is the first result, and PUSH when it is a push message.
local function read(conn)
    local line = read_line(conn)
    local kind = byte(line, 1)
    local rest = sub(line, 2)
    if kind == 36 then -- $
        local n = count_of(conn, rest)
        if n < 0 then
            return nil
        end
        return read_bulk(conn, n)
    elseif kind == 43 then -- +
        return rest
    elseif kind == 58 then -- :
        return tonumber(rest)
    elseif kind == 45 then -- -
        return server_error(rest), ERR
    elseif kind == 42 or kind == 62 then -- * and >
        local n = count_of(conn, rest)
        if n < 0 then
            return nil
        end
        local list = {}
        for i = 1, n do
            list[i] = (read(conn))
        end
        if kind == 62 then
            return list, PUSH
        end
        return list
    elseif kind == 95 then -- _
        return nil
    elseif kind == 37 then -- %
        local map = {}
        for _ = 1, count_of(conn, rest) do
            local key = read(conn)
            local value = read(conn)
            if key ~= nil then
                map[key] = value
            end
        end
        return map
    elseif kind == 126 then -- ~
        local set = {}
        for _ = 1, count_of(conn, rest) do
            local member = read(conn)
            if member ~= nil then
                set[member] = true
            end
        end
        return set
    elseif kind == 35 then -- #
        return rest == "t"
    elseif kind == 44 then -- ,
        if rest == "inf" or rest == "+inf" then
            return math.huge
        elseif rest == "-inf" then
            return -math.huge
        elseif rest == "nan" or rest == "-nan" then
            return 0 / 0
        end
        return tonumber(rest)
    elseif kind == 40 then -- (
        return bigint(rest)
    elseif kind == 33 then -- !
        local text = read_bulk(conn, count_of(conn, rest))
        return server_error(type(text) == "string" and text or v_tostring(text, 0, #text, "lossy")), ERR
    elseif kind == 61 then -- =
        local text = read_bulk(conn, count_of(conn, rest))
        return type(text) == "string" and sub(text, 5) or text
    elseif kind == 124 then -- |
        for _ = 1, count_of(conn, rest) * 2 do
            read(conn)
        end
        return read(conn)
    end
    fail(conn, "PROTOCOL", `the reply starts with the unknown type '$(sub(line, 1, 1))'`)
end

-- Reads the reply of a command, passing over push messages.
local function read_reply(conn)
    local value, tag = read(conn)
    while tag == PUSH do
        value, tag = read(conn)
    end
    return value, tag
end

-- Sends one command and returns its reply and the tag of `read`. `busy`
-- stays true when an error interrupts the exchange, which tells the pool to
-- close the connection.
local function roundtrip(conn, payload)
    conn.busy = true
    send(conn, payload)
    local value, tag = read_reply(conn)
    conn.busy = false
    return value, tag
end

local function request(conn, ...)
    local flat, n = collect(...)
    local value, tag = roundtrip(conn, encode(flat, n))
    if tag then
        error(value, 0)
    end
    return value
end

local Conn = {}
Conn.__index = Conn

-- Wakes the caller that has waited longest for the pool and passes it
-- `conn`, or the right to open a connection when `conn` is false. Returns
-- whether a caller waited.
local function grant(pool, conn)
    local waiters = pool.waiters
    local waiter = waiters[1]
    if not waiter then
        return false
    end
    table.remove(waiters, 1)
    waiter.granted = true
    waiter.conn = conn
    close(waiter.sleep)
    return true
end

-- Gives up a place in the pool whose connection is gone. The first waiting
-- caller takes the place over.
local function vacate(pool)
    if pool.closed or not grant(pool, false) then
        pool.size = pool.size - 1
    end
end

-- Returns a connection to its pool, or closes it when a command left it in
-- an unknown state. A caller that waits for the pool receives the
-- connection directly.
Conn.__close = function(conn)
    local pool = conn.pool
    if not pool then
        return
    end
    if conn.busy or conn.broken or conn.watching or pool.closed then
        conn.sock:close()
        vacate(pool)
    elseif not grant(pool, conn) then
        local idle = pool.idle
        idle[#idle + 1] = conn
    end
end

local function handshake(conn, config)
    local password, username, name = config.password, config.username, config.client_name
    local fallback = config.protocol == 2
    if not fallback then
        local hello = { "HELLO", "3" }
        if password then
            hello[#hello + 1] = { "AUTH", username or "default", password }
        end
        if name then
            hello[#hello + 1] = { "SETNAME", name }
        end
        local flat, n = collect(hello)
        local reply, tag = roundtrip(conn, encode(flat, n))
        if not tag then
            conn.resp = 3
            conn.server = reply
        else
            local code = reply.code
            if code == "NOPROTO" or (code == "NOAUTH" and password)
                or (code == "ERR" and find(reply.message, "unknown command", 1, true)) then
                fallback = true
            else
                error(reply, 0)
            end
        end
    end
    if fallback then
        conn.resp = 2
        if password then
            if username then
                request(conn, "AUTH", username, password)
            else
                request(conn, "AUTH", password)
            end
        end
        if name then
            request(conn, "CLIENT", "SETNAME", name)
        end
    end
    if config.db and config.db ~= 0 then
        request(conn, "SELECT", config.db)
    end
end

-- Opens a connection and prepares it with the settings of `config`.
local function open(config)
    -- The timeout bounds the connection and the TLS handshake, then stays
    -- on the socket as the timeout of every wait.
    local sock, err
    if config.tls then
        sock, err = network.tls.connect(config.host, config.port, config.tls)
    else
        sock, err = network.tcp.connect(config.host, config.port, config.connect)
    end
    if sock == nil then
        error(socket_error(err), 0)
    end
    local conn = setmetatable({
        sock = sock,
        pool = false,
        busy = false,
        broken = false,
        watching = false,
        resp = 3,
        server = false,
    }, Conn)
    local ready, reason = catch handshake(conn, config)
    if not ready then
        sock:close()
        if type(reason) == "string" then
            reason = new_error("CONNECTION", reason)
        end
        error(reason, 0)
    end
    return conn
end

-- RESP2 replies ------------------------------------------------------------------

local function pairs_to_map(list)
    local map = {}
    for i = 1, #list, 2 do
        map[list[i]] = list[i + 1]
    end
    return map
end

local function list_to_set(list)
    local set = {}
    for i = 1, #list do
        set[list[i]] = true
    end
    return set
end

local function text_to_number(text)
    return tonumber(text)
end

-- The commands whose RESP2 reply differs in type from their RESP3 reply.
local RESP2 = {
    HGETALL = pairs_to_map,
    ["CONFIG GET"] = pairs_to_map,
    SMEMBERS = list_to_set,
    SINTER = list_to_set,
    SUNION = list_to_set,
    SDIFF = list_to_set,
    ZSCORE = text_to_number,
    ZINCRBY = text_to_number,
}

-- Converts the RESP2 reply of the command in `flat` to its RESP3 value.
local function reshape(flat, value)
    local name = flat[1]
    if value == nil or type(name) ~= "string" or getmetatable(value) == Error then
        return value
    end
    name = upper(name)
    local convert = RESP2[name]
    if convert == nil and name == "CONFIG" and type(flat[2]) == "string" then
        convert = RESP2[`$name $(upper(flat[2]))`]
    end
    if convert and (type(value) == "table" or convert == text_to_number) then
        return convert(value)
    end
    return value
end

-- Command methods -----------------------------------------------------------------

-- `Commands` holds one method per command name, made the first time a
-- program uses the name. Each method passes the words of the name and its
-- arguments to the `call` method of its object.
local Commands = setmetatable({}, {
    __index = function(commands, name)
        if type(name) ~= "string" or not find(name, "^%l[%l%d_]*$") then
            return nil
        end
        local words = {}
        for word in gmatch(name, "[^_]+") do
            words[#words + 1] = upper(word)
        end
        local method
        if #words == 1 then
            local a = words[1]
            method = function(self, ...) return self:call(a, ...) end
        elseif #words == 2 then
            local a, b = words[1], words[2]
            method = function(self, ...) return self:call(a, b, ...) end
        else
            method = function(self, ...) return self:call(words, ...) end
        end
        commands[name] = method
        return method
    end,
})

-- The pool -----------------------------------------------------------------------

local Client = setmetatable({}, { __index = Commands })
local ClientMeta = { __index = Client, __name = "redis.client" }

local Slot = {
    __close = function(slot)
        if not slot.kept then
            vacate(slot.pool)
        end
    end,
}

-- Opens a connection for a place that `pool.size` already counts.
local function open_place(pool)
    local slot <close> = setmetatable({ pool = pool, kept = false }, Slot)
    local conn = open(pool.config)
    conn.pool = pool
    slot.kept = true
    return conn
end

-- A caller that waits for the pool. Its `sleep` never runs out, so the
-- caller uses no processor time until `grant` or `Client:close` closes the
-- sleep. Leaving the wait without taking what `grant` passed, as a cancelled
-- coroutine does, hands it to the next caller.
local Waiter = {
    __close = function(waiter)
        local pool = waiter.pool
        if waiter.taken then
            return
        end
        if waiter.granted then
            if conn = waiter.conn then
                Conn.__close(conn)
            else
                vacate(pool)
            end
            return
        end
        local waiters = pool.waiters
        for i = 1, #waiters do
            if waiters[i] == waiter then
                table.remove(waiters, i)
                break
            end
        end
        close(waiter.sleep)
    end,
}

-- The body of the detached coroutine that waits in the sleep of a waiter.
-- A sleep can be closed while a detached coroutine waits in it, so the
-- caller resumes this coroutine, which works from the main chunk and from
-- every kind of coroutine.
local function park(s)
    resume(s)
end

-- Takes a connection from the pool, opening one when the pool has room.
-- The caller declares the result with `<close>`, which returns it. When the
-- pool is full the caller joins the end of `pool.waiters`, and connections
-- that return go to the waiting callers in the order of their arrival.
local function checkout(pool)
    if pool.closed then
        error(new_error("CONNECTION", "the client is closed"), 0)
    end
    local idle = pool.idle
    local n = #idle
    if n > 0 then
        local conn = idle[n]
        idle[n] = nil
        return conn
    end
    if pool.size < pool.max then
        pool.size = pool.size + 1
        return open_place(pool)
    end
    local granted, conn = false, false
    do
        local waiters = pool.waiters
        local waiter <close> = setmetatable({
            pool = pool,
            sleep = sleep(math.huge),
            granted = false,
            conn = false,
            taken = false,
        }, Waiter)
        waiters[#waiters + 1] = waiter
        resume(detach(create(park), waiter.sleep))
        granted, conn = waiter.granted, waiter.conn
        waiter.taken = granted
    end
    if granted then
        return conn or open_place(pool)
    end
    if pool.closed then
        error(new_error("CONNECTION", "the client is closed"), 0)
    end
    -- The resume returns without a grant when every detached coroutine
    -- waits for another one, so no command can end.
    error(new_error("CONNECTION", "every connection of the pool is in use and none can return"), 0)
end

local function percent_decode(text)
    return (text:gsub("%%(%x%x)", function(hex) return string.char(tonumber(hex, 16)) end))
end

local SCHEMES = { redis = false, valkey = false, rediss = true, valkeys = true }

local function parse_url(url)
    local scheme, rest = match(url, "^(%a[%w+.-]*)://(.*)$")
    local tls = scheme and SCHEMES[scheme:lower()]
    if tls == nil then
        error(`invalid Redis URL '$url'`, 0)
    end
    rest = match(rest, "^[^?#]*")
    local authority, path = match(rest, "^([^/]*)(.*)$")
    local config = { tls = tls or nil }
    local userinfo, address = match(authority, "^(.*)@(.*)$")
    if userinfo then
        local user, password = match(userinfo, "^([^:]*):(.*)$")
        if user == nil then
            user = userinfo
        end
        if user ~= "" then
            config.username = percent_decode(user)
        end
        if password and password ~= "" then
            config.password = percent_decode(password)
        end
    else
        address = authority
    end
    local host, port = match(address, "^%[(.*)%]:?(%d*)$")
    if host == nil then
        host, port = match(address, "^([^:]*):?(%d*)$")
    end
    if host == nil then
        error(`invalid Redis URL '$url'`, 0)
    end
    if host ~= "" then
        config.host = host
    end
    if port ~= "" then
        config.port = tonumber(port)
    end
    if path ~= "" and path ~= "/" then
        local db = match(path, "^/(%d+)$")
        if db == nil then
            error(`invalid database in the Redis URL '$url'`, 0)
        end
        config.db = tonumber(db)
    end
    return config
end

local OPTIONS = {
    host = "string", port = "number", username = "string", password = "string", db = "number",
    tls = true, timeout = "number", pool = "number", client_name = "string", protocol = "number",
}

--- Connects to a Redis server and returns a client.
---
--- `target` is a URL or a table of options. A URL has the form
--- `redis://USER:PASSWORD@HOST:PORT/DB`, in which every part but the scheme
--- is optional. The scheme `rediss` connects through TLS. The schemes
--- `valkey` and `valkeys` mean the same as `redis` and `rediss`. A user
--- name or a password with a reserved character is percent-encoded.
---
--- The options are:
---
--- - `host`, which defaults to `"127.0.0.1"`, and `port`, which defaults to 6379.
--- - `username` and `password`, which the client sends with `AUTH`. A password alone authenticates the user `default`.
--- - `db`, the number of the database that the client selects with `SELECT`.
--- - `tls`, which is `true` to connect through TLS, or a table of the client options of `network.tls.connect`, such as `ca` and `servername`.
--- - `timeout`, the seconds that the connection to the server, its TLS handshake, and then each wait on the socket may last. A connection or a command that runs into it closes the connection and raises an error object with the code `"CONNECTION"` whose `timeout` field is `true`. By default they wait without limit.
--- - `pool`, the largest number of connections that the client opens, which defaults to 10. The client opens a connection when a command finds none free.
--- - `client_name`, the name that the connections give to the server.
--- - `protocol`, which is 2 to keep the RESP2 protocol. By default the client asks for RESP3.
---
--- The fields of `options` replace those of a URL.
---
--- The field `resp` of the client is 3 or 2, the protocol that the server
--- accepted. The field `server` is the reply of the server to `HELLO`, a
--- table with fields such as `version`, or false under RESP2.
---
--- The call opens the first connection before it returns. It raises an
--- error for an invalid URL or option. A server that cannot be reached
--- raises an error object with the code `"CONNECTION"`. A refused
--- password raises the error object of the server, whose code is
--- `"WRONGPASS"`. The call requires `network:tcp` for the host and port.
--- @param target string|table A URL or a table of options.
--- @param options table? Options that add to a URL.
--- @return table The client.
function M.connect(target, options)
    local config
    if type(target) == "string" then
        config = parse_url(target)
    elseif type(target) == "table" then
        config = {}
        options = target
    else
        error("bad argument #1 to 'connect' (string or table expected)", 2)
    end
    for name, value in pairs(options or EMPTY) do
        local kind = OPTIONS[name]
        if kind == nil then
            error(`unknown redis option '$(tostring(name))'`, 2)
        end
        if kind ~= true and type(value) ~= kind then
            error(`the redis option '$name' must be a $kind`, 2)
        end
        config[name] = value
    end
    config.host = config.host or "127.0.0.1"
    config.port = config.port or 6379
    if config.tls then
        local tls = {}
        if type(config.tls) == "table" then
            for name, value in pairs(config.tls) do
                tls[name] = value
            end
        end
        if tls.timeout == nil then
            tls.timeout = config.timeout
        end
        config.tls = tls
    else
        config.tls = false
        config.connect = config.timeout and { timeout = config.timeout } or nil
    end
    local client = setmetatable({
        config = config,
        idle = {},
        size = 0,
        max = max_of(1, floor(config.pool or 10)),
        waiters = {},
        closed = false,
        resp = 3,
    }, ClientMeta)
    do
        local conn <close> = checkout(client)
        client.resp = conn.resp
        client.server = conn.server
    end
    return client
end

--- Sends a command and returns its reply.
---
--- The first argument is the name of the command. The others are its
--- arguments, under the rules of the package overview. A method named after
--- a command, such as `r:get("k")`, is the same call.
---
--- The call returns the reply as a Lus value. It raises the error object of
--- an error reply. A connection that fails raises an error object with the
--- code `"CONNECTION"`.
--- @param ... any The name of the command and its arguments.
--- @return any The reply.
function Client:call(...)
    local flat, n = collect(...)
    local conn <close> = checkout(self)
    local value, tag = roundtrip(conn, encode(flat, n))
    if tag then
        error(value, 0)
    end
    if conn.resp == 2 then
        return reshape(flat, value)
    end
    return value
end

-- The commands that change the state of one connection have no meaning on a
-- pool.
for name, hint in pairs({
    multi = "r:transaction",
    exec = "r:transaction",
    discard = "r:transaction",
    watch = "the watch option of r:transaction",
    unwatch = "the watch option of r:transaction",
    select = "the db option of redis.connect",
}) do
    Client[name] = function()
        error(`a pooled client cannot send $(upper(name)), use $hint`, 2)
    end
end

--- Closes the client and its connections.
---
--- A connection that a command still uses closes when that command ends.
--- Every later call on the client raises an error object with the code
--- `"CONNECTION"`. A second close does nothing. A client declared with
--- `<close>` closes at the end of its scope.
function Client:close()
    if self.closed then
        return
    end
    self.closed = true
    local idle = self.idle
    for i = #idle, 1, -1 do
        idle[i].sock:close()
        idle[i] = nil
        self.size = self.size - 1
    end
    -- The callers that wait for a connection wake up and raise the error
    -- of a closed client.
    local waiters = self.waiters
    self.waiters = {}
    for i = 1, #waiters do
        close(waiters[i].sleep)
    end
end

ClientMeta.__close = Client.close

-- Pipelines ----------------------------------------------------------------------

local Batch = setmetatable({}, { __index = Commands })
local BatchMeta = { __index = Batch, __name = "redis.pipeline" }

function Batch:call(...)
    local flat, n = collect(...)
    local count = self.count + 1
    self.count = count
    self.payloads[count] = encode(flat, n)
    self.commands[count] = flat
end

local function new_batch()
    return setmetatable({ count = 0, payloads = {}, commands = {} }, BatchMeta)
end

--- Sends several commands in one write and returns their replies.
---
--- `fn` receives a pipeline, which has the command methods and `call` of a
--- client. Each of them records its command and returns nothing. When `fn`
--- returns, the client sends the recorded commands together on one
--- connection and reads one reply for each.
---
--- The call returns a list with the reply of each command at its position
--- and the number of commands in the field `n`. A command that failed has
--- its error object at its position, which `redis.is_error` recognizes. An
--- error that `fn` raises propagates before anything is sent.
--- @param fn function The function that records the commands.
--- @return table The replies.
function Client:pipeline(fn)
    local batch = new_batch()
    fn(batch)
    local count = batch.count
    local results = { n = count }
    if count == 0 then
        return results
    end
    local conn <close> = checkout(self)
    conn.busy = true
    send(conn, batch.payloads)
    local commands = batch.commands
    local resp2 = conn.resp == 2
    for i = 1, count do
        local value = read_reply(conn)
        if resp2 then
            value = reshape(commands[i], value)
        end
        results[i] = value
    end
    conn.busy = false
    return results
end

-- Transactions -------------------------------------------------------------------

-- The second argument of a transaction function: an object whose commands
-- run at once on the connection of the transaction.
local Bound = setmetatable({}, { __index = Commands })
local BoundMeta = { __index = Bound, __name = "redis.connection" }

function Bound:call(...)
    local conn = self.conn
    if not conn then
        error("the transaction has ended", 2)
    end
    local flat, n = collect(...)
    local value, tag = roundtrip(conn, encode(flat, n))
    if tag then
        error(value, 0)
    end
    if conn.resp == 2 then
        return reshape(flat, value)
    end
    return value
end

local MULTI = "*1\r\n$5\r\nMULTI\r\n"
local EXEC = "*1\r\n$4\r\nEXEC\r\n"

-- Runs one attempt of a transaction. Returns the replies, or nil when a
-- watched key changed.
local function attempt(conn, fn, watch)
    local bound = setmetatable({ conn = conn }, BoundMeta)
    if watch then
        request(conn, "WATCH", watch)
        conn.watching = true
    end
    local batch = new_batch()
    local ok, err = catch fn(batch, bound)
    bound.conn = false
    local count = batch.count
    if not ok or count == 0 then
        if watch and not conn.busy and not conn.broken then
            request(conn, "UNWATCH")
            conn.watching = false
        end
        if not ok then
            error(err, 0)
        end
        return { n = 0 }
    end
    local payloads = batch.payloads
    table.insert(payloads, 1, MULTI)
    payloads[count + 2] = EXEC
    conn.busy = true
    send(conn, payloads)
    local first = nil
    local started, tag = read_reply(conn)
    if tag then
        first = started
    end
    for _ = 1, count do
        local queued, queue_tag = read_reply(conn)
        if queue_tag and first == nil then
            first = queued
        end
    end
    local replies, exec_tag = read_reply(conn)
    conn.busy = false
    conn.watching = false
    if exec_tag then
        error(first or replies, 0)
    end
    if replies == nil then
        return nil
    end
    if conn.resp == 2 then
        local commands = batch.commands
        for i = 1, count do
            replies[i] = reshape(commands[i], replies[i])
        end
    end
    replies.n = count
    return replies
end

--- Runs commands as one transaction with `MULTI` and `EXEC`.
---
--- `fn` receives a transaction, which has the command methods and `call` of
--- a client. Each of them records its command and returns nothing. When
--- `fn` returns, the client sends `MULTI`, the recorded commands, and `EXEC`
--- together. The server runs the commands with no command of another
--- client between them.
---
--- The options are:
---
--- - `watch`, a key or a list of keys that the client watches with `WATCH` before it calls `fn`. The server then runs the transaction only if none of these keys changed in the meantime.
--- - `retries`, how many more times the client runs `fn` after a watched key changed, which defaults to 0.
---
--- `fn` receives a second argument, an object with the same methods whose
--- commands run at once on the connection of the transaction and return
--- their replies. A function reads the watched keys through it and records
--- the writes that depend on what it read.
---
--- The call returns a list with the reply of each command at its position
--- and the number of commands in the field `n`. A command that failed while
--- the transaction ran has its error object at its position. The call
--- returns nil when a watched key changed in every attempt.
---
--- A command that the server refuses to queue cancels the transaction, and
--- the call raises the error object of that command. An error that `fn`
--- raises propagates before anything is sent.
--- @param fn function The function that records the commands.
--- @param options table? `watch` and `retries`.
--- @return table? The replies, or nil when a watched key changed.
function Client:transaction(fn, options)
    local watch = options and options.watch or nil
    if type(watch) == "table" and #watch == 0 then
        watch = nil
    end
    local retries = options and options.retries or 0
    local conn <close> = checkout(self)
    for _ = 0, retries do
        if replies = attempt(conn, fn, watch) then
            return replies
        end
    end
    return nil
end

-- Publish and subscribe -----------------------------------------------------------

local Subscription = {}
Subscription.__index = Subscription
Subscription.__name = "redis.subscription"

-- Reads one message of the subscription connection. Returns the channel,
-- the payload, and the pattern of a published message, or nil after a
-- message that confirms a change of the subscriptions.
local function sub_read(self)
    local frame, tag = read(self.conn)
    if tag == ERR then
        error(frame, 0)
    end
    if type(frame) ~= "table" then
        return nil
    end
    local kind = frame[1]
    if kind == "message" then
        return frame[2], frame[3]
    elseif kind == "pmessage" then
        return frame[3], frame[4], frame[2]
    elseif kind == "subscribe" or kind == "psubscribe" or kind == "unsubscribe" or kind == "punsubscribe" then
        self.count = frame[3]
        self.acks = self.acks - 1
    end
    return nil
end

-- Sends a subscription command and waits until the server has confirmed
-- each of its names. Messages that arrive in the meantime wait in a queue.
local function sub_send(self, command, names, acks)
    if self.closed then
        error(new_error("CONNECTION", "the subscription is closed"), 0)
    end
    local flat, n = collect(command, names)
    local conn = self.conn
    self.acks = self.acks + acks
    send(conn, encode(flat, n))
    local queue = self.queue
    while self.acks > 0 do
        local channel, message, pattern = sub_read(self)
        if channel ~= nil then
            queue[#queue + 1] = { channel, message, pattern }
        end
    end
end

local function add_names(set, names)
    for i = 1, #names do
        set[names[i]] = true
    end
end

local function remove_names(self, field, names)
    local set = self[field]
    if #names == 0 then
        local n = 0
        for _ in pairs(set) do
            n = n + 1
        end
        self[field] = {}
        return max_of(1, n)
    end
    for i = 1, #names do
        set[names[i]] = nil
    end
    return #names
end

--- Subscribes the subscription to more channels.
---
--- The call returns once the server has confirmed every channel. It raises
--- the error object of the server when the server refuses. On a closed
--- subscription it raises an error object with the code `"CONNECTION"`.
--- @param ... string The channels.
function Subscription:subscribe(...)
    local names = { ... }
    if #names > 0 then
        add_names(self.channels, names)
        sub_send(self, "SUBSCRIBE", names, #names)
    end
end

--- Subscribes the subscription to the channels that match patterns.
---
--- A pattern is a glob of the server, such as `"news.*"`. The call returns
--- once the server has confirmed every pattern. It raises the errors of
--- `sub:subscribe`.
--- @param ... string The patterns.
function Subscription:psubscribe(...)
    local names = { ... }
    if #names > 0 then
        add_names(self.patterns, names)
        sub_send(self, "PSUBSCRIBE", names, #names)
    end
end

--- Leaves channels, or every channel when the call names none.
---
--- The call returns once the server has confirmed. A subscription that is
--- left with no channel and no pattern ends its loop at the next step and
--- closes.
--- @param ... string The channels.
function Subscription:unsubscribe(...)
    local names = { ... }
    sub_send(self, "UNSUBSCRIBE", names, remove_names(self, "channels", names))
end

--- Leaves patterns, or every pattern when the call names none.
---
--- The call behaves as `sub:unsubscribe` does for channels.
--- @param ... string The patterns.
function Subscription:punsubscribe(...)
    local names = { ... }
    sub_send(self, "PUNSUBSCRIBE", names, remove_names(self, "patterns", names))
end

--- Closes the connection of the subscription, which ends its loop.
---
--- A coroutine that waits for a message of the subscription leaves its loop.
--- A second close does nothing.
function Subscription:close()
    if not self.closed then
        self.closed = true
        self.conn.sock:close()
    end
end

Subscription.__close = Subscription.close

-- The iterator of a subscription. Each step waits for the next message.
local function next_message(self)
    local queue = self.queue
    while true do
        if #queue > 0 then
            local item = table.remove(queue, 1)
            return item[1], item[2], item[3]
        end
        if self.closed then
            return nil
        end
        if self.count == 0 and self.acks <= 0 then
            self:close()
            return nil
        end
        local ok, channel, message, pattern = catch sub_read(self)
        if not ok then
            if self.closed then
                return nil
            end
            self:close()
            error(channel, 0)
        end
        if channel ~= nil then
            return channel, message, pattern
        end
    end
end

local function subscription(client, command, names)
    if #names == 0 then
        error(`bad argument #1 to '$(command:lower())' (channel expected)`, 3)
    end
    local config = client.config
    if client.closed then
        error(new_error("CONNECTION", "the client is closed"), 0)
    end
    local conn = open(config)
    -- A subscription waits for as long as no message arrives.
    conn.sock:settimeout(nil)
    local self = setmetatable({
        conn = conn,
        count = 0,
        acks = 0,
        queue = {},
        channels = {},
        patterns = {},
        closed = false,
    }, Subscription)
    add_names(command == "SUBSCRIBE" and self.channels or self.patterns, names)
    local ok, err = catch sub_send(self, command, names, #names)
    if not ok then
        self:close()
        error(err, 0)
    end
    return next_message, self, nil, self
end

--- Subscribes to channels and returns an iterator over their messages.
---
--- The call opens a connection of its own, outside the pool, subscribes it,
--- and returns once the server has confirmed every channel. Each step of
--- the loop `for channel, message in r:subscribe("a", "b") do` waits for
--- the next message and yields the channel and the payload. A message that
--- arrived through a pattern yields that pattern as a third value. Inside a
--- detached coroutine a step suspends the coroutine while the others run.
---
--- Leaving the loop with `break`, `return`, or an error closes the
--- connection, which ends the subscriptions. The second result of the call
--- is the subscription, whose methods `subscribe`, `psubscribe`,
--- `unsubscribe`, `punsubscribe`, and `close` change it while the loop
--- runs. The loop ends when the subscription closes or has left every
--- channel and pattern.
---
--- The call raises an error when it names no channel, an error object with
--- the code `"CONNECTION"` when the server cannot be reached, and the error
--- object of the server when the server refuses. A step raises an error
--- object with the code `"CONNECTION"` when the connection fails.
--- @param ... string The channels.
--- @return function The iterator.
--- @return table The subscription.
function Client:subscribe(...)
    return subscription(self, "SUBSCRIBE", { ... })
end

--- Subscribes to the channels that match patterns and returns an iterator
--- over their messages.
---
--- A pattern is a glob of the server, such as `"news.*"`. Each step yields
--- the channel, the payload, and the pattern that matched. Everything else
--- is as in `r:subscribe`.
--- @param ... string The patterns.
--- @return function The iterator.
--- @return table The subscription.
function Client:psubscribe(...)
    return subscription(self, "PSUBSCRIBE", { ... })
end

-- Scripts ------------------------------------------------------------------------

local Script = {}
Script.__index = Script
Script.__name = "redis.script"

Script.__call = function(self, keys, ...)
    local client = self.client
    keys = keys or EMPTY
    local flat, n = collect("EVALSHA", self.sha, #keys, keys, ...)
    local payload = encode(flat, n)
    local value, tag
    do
        local conn <close> = checkout(client)
        value, tag = roundtrip(conn, payload)
    end
    if tag and value.code == "NOSCRIPT" then
        client:call("SCRIPT", "LOAD", self.source)
        local conn <close> = checkout(client)
        value, tag = roundtrip(conn, payload)
    end
    if tag then
        error(value, 0)
    end
    return value
end

--- Returns a server-side Lua script as a function.
---
--- The result is a callable value. `script(keys, ...)` runs the script with
--- the list `keys` as its `KEYS` and the other arguments as its `ARGV`, and
--- returns its reply. The call sends `EVALSHA` with the SHA-1 digest of the
--- source. When the server answers that it lacks the script, the call loads
--- the source with `SCRIPT LOAD` and sends `EVALSHA` again. The field `sha`
--- holds the digest as hexadecimal text. The field `source` holds the source.
---
--- Running the script raises the error object of an error that the script
--- or the server reports. The generic methods `r:eval` and `r:evalsha` send
--- the two commands as they are.
--- @param source string The Lua source of the script.
--- @return table The callable script.
function Client:script(source)
    if type(source) ~= "string" then
        error("bad argument #1 to 'script' (string expected)", 2)
    end
    return setmetatable({
        client = self,
        source = source,
        sha = string.transcode(crypto.hash("sha1", source), "binary", "hex"),
    }, Script)
end

-- Scans --------------------------------------------------------------------------

local function scanner(client, command, key, options, paired, numeric)
    options = options or EMPTY
    local cursor, batch, at, size, done = "0", EMPTY, 0, 0, false
    return function()
        while at >= size do
            if done then
                return nil
            end
            local reply
            if key ~= nil then
                reply = client:call(command, key, cursor, options)
            else
                reply = client:call(command, cursor, options)
            end
            cursor, batch = tostring(reply[1]), reply[2]
            at, size = 0, #batch
            done = cursor == "0"
        end
        if paired then
            at = at + 2
            local value = batch[at]
            return batch[at - 1], numeric and tonumber(value) or value
        end
        at = at + 1
        return batch[at]
    end
end

--- Returns an iterator over the keys of the database.
---
--- The loop `for key in r:scan({ match = "user:*" }) do` sends `SCAN` with
--- each cursor that the server returns until the scan is complete. The
--- options are the options of the command: `match`, a glob that the keys
--- must match, `count`, a hint for the number of keys per request, and
--- `type`, the type of the keys to return. The server may return a key more
--- than once, as the command documents.
---
--- A step raises the errors of `r:call`.
--- @param options table? `match`, `count`, and `type`.
--- @return function The iterator.
function Client:scan(options)
    return scanner(self, "SCAN", nil, options, false, false)
end

--- Returns an iterator over the members of a set, which it reads with `SSCAN`.
--- @param key string The key of the set.
--- @param options table? `match` and `count`, as in `r:scan`.
--- @return function The iterator, which yields one member per step.
function Client:sscan(key, options)
    return scanner(self, "SSCAN", key, options, false, false)
end

--- Returns an iterator over the fields of a hash, which it reads with `HSCAN`.
--- @param key string The key of the hash.
--- @param options table? `match` and `count`, as in `r:scan`.
--- @return function The iterator, which yields a field and its value per step.
function Client:hscan(key, options)
    return scanner(self, "HSCAN", key, options, true, false)
end

--- Returns an iterator over the members of a sorted set, which it reads with `ZSCAN`.
--- @param key string The key of the sorted set.
--- @param options table? `match` and `count`, as in `r:scan`.
--- @return function The iterator, which yields a member and its score as a number per step.
function Client:zscan(key, options)
    return scanner(self, "ZSCAN", key, options, true, true)
end

-- The store of rate_limit ----------------------------------------------------------

local function milliseconds(seconds)
    return max_of(1, ceil(seconds * 1000))
end

local RATE_INCR = [[
-- rate_limit.incr
local count = redis.call('INCRBYFLOAT', KEYS[1], ARGV[1])
local ttl = redis.call('PTTL', KEYS[1])
if ttl < 0 then
  ttl = tonumber(ARGV[2])
  redis.call('PEXPIRE', KEYS[1], ttl)
end
return {count, ttl}
]]

local RATE_TAKE = [[
-- rate_limit.take
local cost, interval = tonumber(ARGV[1]), tonumber(ARGV[2])
local burst, now = tonumber(ARGV[3]), tonumber(ARGV[4])
local stored = redis.call('GET', KEYS[1])
local full_at = stored and tonumber(stored)
if not full_at or full_at < now then
  full_at = now
end
local debt = full_at + cost * interval - now
if debt > burst * interval + 1e-9 then
  return {0, string.format('%.17g', full_at - now)}
end
local ttl = math.max(1, math.ceil(debt * 1000))
redis.call('SET', KEYS[1], string.format('%.17g', now + debt), 'PX', ttl)
return {1, string.format('%.17g', debt)}
]]

local RateStore = {}
RateStore.__index = RateStore

function RateStore:incr(key, ttl, amount)
    local reply = self.incr_script({ self.prefix .. key }, amount or 1, milliseconds(ttl))
    return tonumber(reply[1]), reply[2] / 1000
end

function RateStore:get(key)
    local value = self.client:call("GET", self.prefix .. key)
    return value and tonumber(value) or nil
end

function RateStore:set(key, value, ttl)
    self.client:call("SET", self.prefix .. key, format("%.17g", value), "PX", milliseconds(ttl))
end

function RateStore:take(key, cost, interval, burst, now)
    local reply = self.take_script({ self.prefix .. key }, format("%.17g", cost), format("%.17g", interval),
        format("%.17g", burst), format("%.17g", now))
    return reply[1] == 1, tonumber(reply[2])
end

--- Returns a store for the `rate_limit` package that keeps its counters in
--- Redis.
---
--- The store has the methods `incr`, `get`, `set`, and `take` that
--- `rate_limit` documents, so limiters in several processes share their
--- counters. `incr` and `take` each run as one Lua script on the server,
--- which makes them atomic. The server expires the counters by its own
--- clock. The option `prefix` starts every key and defaults to
--- `"rate_limit:"`.
---
--- Each method raises the errors of `r:call`.
--- @param client table The client from `redis.connect`.
--- @param options table? `prefix`.
--- @return table The store.
function M.rate_limit_store(client, options)
    return setmetatable({
        client = client,
        prefix = options and options.prefix or "rate_limit:",
        incr_script = client:script(RATE_INCR),
        take_script = client:script(RATE_TAKE),
    }, RateStore)
end

-- The store of session -------------------------------------------------------------

local SessionStore = {}
SessionStore.__index = SessionStore

function SessionStore:get(id)
    local text = self.client:call("GET", self.prefix .. id)
    if type(text) ~= "string" then
        return nil
    end
    return fromjson(text)
end

function SessionStore:set(id, data, ttl)
    self.client:call("SET", self.prefix .. id, tojson(data), "PX", milliseconds(ttl))
end

function SessionStore:destroy(id)
    self.client:call("DEL", self.prefix .. id)
end

--- Returns a store for the `session` package that keeps its sessions in
--- Redis.
---
--- The store has the methods `get`, `set`, and `destroy` that `session`
--- documents. A session is one key that holds its data as JSON and that the
--- server expires `ttl` seconds after the last save. The option `prefix`
--- starts every key and defaults to `"session:"`.
---
--- Each method raises the errors of `r:call`.
--- @param client table The client from `redis.connect`.
--- @param options table? `prefix`.
--- @return table The store.
function M.session_store(client, options)
    return setmetatable({
        client = client,
        prefix = options and options.prefix or "session:",
    }, SessionStore)
end

-- The store of queue ---------------------------------------------------------------

-- Every key of a queue starts with `KEYS[1]`, which ends in a hash tag, so
-- the keys of one queue share a slot of a cluster.
--
-- - `job:ID` is a hash with the fields of a job and its sequence number.
-- - `timed` is a sorted set of the waiting jobs by the time they become due.
-- - `ready` is a sorted set of the due jobs. The score is the negated
--   priority. The member is the due time and the sequence number as two
--   numbers of 15 digits, then the id, so the first member is the job that
--   workers take first.
-- - `active` is a sorted set of the claimed jobs by the end of their lease.
-- - `stale` is a set of the jobs in `ready` whose lease ran out, which
--   stay active until a worker claims them again.
-- - `completed` and `failed` are sorted sets by the time the jobs ended.
-- - `seq` counts the jobs.

local QUEUE_ADD = [[
-- queue.add
local base = KEYS[1]
local job = base .. 'job:' .. ARGV[1]
if redis.call('EXISTS', job) == 1 then
  return 0
end
local seq = redis.call('INCR', base .. 'seq')
redis.call('HSET', job, 'id', ARGV[1], 'data', ARGV[2], 'status', 'waiting',
  'priority', ARGV[3], 'attempts', 0, 'max_attempts', ARGV[4],
  'run_at', ARGV[5], 'created_at', ARGV[6], 'seq', seq)
redis.call('ZADD', base .. 'timed', ARGV[5], ARGV[1])
return 1
]]

local QUEUE_CLAIM = [[
-- queue.claim
local base = KEYS[1]
local now, lease = ARGV[1], ARGV[2]
local ready = base .. 'ready'
local function promote(source, stale)
  local ids = redis.call('ZRANGEBYSCORE', source, '-inf', now)
  for i = 1, #ids do
    local id = ids[i]
    local f = redis.call('HMGET', base .. 'job:' .. id, 'priority', 'run_at', 'seq')
    redis.call('ZREM', source, id)
    if f[1] then
      local member = string.format('%015.0f%015.0f', tonumber(f[2]), tonumber(f[3])) .. id
      redis.call('ZADD', ready, -tonumber(f[1]), member)
      if stale then
        redis.call('SADD', base .. 'stale', id)
      end
    end
  end
end
promote(base .. 'active', true)
promote(base .. 'timed', false)
while true do
  local first = redis.call('ZRANGE', ready, 0, 0)
  if #first == 0 then
    return false
  end
  redis.call('ZREM', ready, first[1])
  local id = string.sub(first[1], 31)
  local job = base .. 'job:' .. id
  redis.call('SREM', base .. 'stale', id)
  if redis.call('EXISTS', job) == 1 then
    local attempts = redis.call('HINCRBY', job, 'attempts', 1)
    redis.call('HSET', job, 'status', 'active', 'run_at', lease)
    redis.call('ZADD', base .. 'active', lease, id)
    local f = redis.call('HMGET', job, 'data', 'max_attempts', 'priority', 'created_at')
    return {id, f[1], attempts, tonumber(f[2]), tonumber(f[3]), tonumber(f[4])}
  end
end
]]

-- The start of `complete` and `fail`: the job must be active with the
-- attempts of the caller, and it leaves the sets of the active jobs.
local QUEUE_HELD = [[
local base = KEYS[1]
local id = ARGV[1]
local job = base .. 'job:' .. id
local f = redis.call('HMGET', job, 'status', 'attempts', 'run_at', 'seq')
if f[1] ~= 'active' or f[2] ~= ARGV[2] then
  return 0
end
redis.call('ZREM', base .. 'active', id)
if redis.call('SREM', base .. 'stale', id) == 1 then
  local member = string.format('%015.0f%015.0f', tonumber(f[3]), tonumber(f[4])) .. id
  redis.call('ZREM', base .. 'ready', member)
end
]]

local QUEUE_COMPLETE = `-- queue.complete\n$QUEUE_HELD` .. [[
if ARGV[4] == '1' then
  redis.call('DEL', job)
else
  redis.call('HSET', job, 'status', 'completed', 'finished_at', ARGV[3])
  redis.call('ZADD', base .. 'completed', ARGV[3], id)
end
return 1
]]

local QUEUE_FAIL = `-- queue.fail\n$QUEUE_HELD` .. [[
if ARGV[5] ~= '' then
  redis.call('HSET', job, 'status', 'waiting', 'run_at', ARGV[5], 'last_error', ARGV[3])
  redis.call('ZADD', base .. 'timed', ARGV[5], id)
else
  redis.call('HSET', job, 'status', 'failed', 'finished_at', ARGV[4], 'last_error', ARGV[3])
  redis.call('ZADD', base .. 'failed', ARGV[4], id)
end
return 1
]]

local QUEUE_STATS = [[
-- queue.stats
local base = KEYS[1]
local stale = redis.call('SCARD', base .. 'stale')
local timed = redis.call('ZCARD', base .. 'timed')
local due = redis.call('ZCOUNT', base .. 'timed', '-inf', ARGV[1])
return {
  redis.call('ZCARD', base .. 'ready') - stale + due,
  timed - due,
  redis.call('ZCARD', base .. 'active') + stale,
  redis.call('ZCARD', base .. 'completed'),
  redis.call('ZCARD', base .. 'failed'),
}
]]

local QUEUE_NEXT_AT = [[
-- queue.next_at
local base = KEYS[1]
local at = false
local function consider(value)
  value = tonumber(value)
  if value and (not at or value < at) then
    at = value
  end
end
local first = redis.call('ZRANGE', base .. 'ready', 0, 0)
if first[1] then
  consider(string.sub(first[1], 1, 15))
end
consider(redis.call('ZRANGE', base .. 'timed', 0, 0, 'WITHSCORES')[2])
consider(redis.call('ZRANGE', base .. 'active', 0, 0, 'WITHSCORES')[2])
return at
]]

local QUEUE_RETRY_FAILED = [[
-- queue.retry_failed
local base = KEYS[1]
local ids = redis.call('ZRANGE', base .. 'failed', 0, -1)
for i = 1, #ids do
  local job = base .. 'job:' .. ids[i]
  redis.call('HSET', job, 'status', 'waiting', 'attempts', 0, 'run_at', ARGV[1])
  redis.call('HDEL', job, 'finished_at')
  redis.call('ZADD', base .. 'timed', ARGV[1], ids[i])
end
redis.call('DEL', base .. 'failed')
return #ids
]]

local QUEUE_CLEAN = [[
-- queue.clean
local base = KEYS[1]
if ARGV[1] ~= 'completed' and ARGV[1] ~= 'failed' then
  return 0
end
local set = base .. ARGV[1]
local ids = redis.call('ZRANGEBYSCORE', set, '-inf', ARGV[2])
for i = 1, #ids do
  redis.call('DEL', base .. 'job:' .. ids[i])
end
redis.call('ZREMRANGEBYSCORE', set, '-inf', ARGV[2])
return #ids
]]

local QueueStore = {}
QueueStore.__index = QueueStore

-- Times and counts travel as whole numbers.
local function whole(n)
    return format("%.0f", n)
end

local function base_of(self, queue)
    return { `$(self.prefix){$queue}:` }
end

function QueueStore:add(queue, job)
    return self.add_script(base_of(self, queue), job.id, job.data, whole(job.priority), whole(job.max_attempts),
        whole(job.run_at), whole(job.created_at)) == 1
end

function QueueStore:claim(queue, now, lease)
    local reply = self.claim_script(base_of(self, queue), whole(now), whole(lease))
    if reply == nil then
        return nil
    end
    return {
        id = reply[1],
        data = reply[2],
        attempts = reply[3],
        max_attempts = reply[4],
        priority = reply[5],
        created_at = reply[6],
    }
end

function QueueStore:complete(queue, id, attempts, now, remove)
    return self.complete_script(base_of(self, queue), id, whole(attempts), whole(now), remove and "1" or "0") == 1
end

function QueueStore:fail(queue, id, attempts, message, now, retry_at)
    return self.fail_script(base_of(self, queue), id, whole(attempts), message, whole(now),
        retry_at and whole(retry_at) or "") == 1
end

local JOB_NUMBERS = { "priority", "attempts", "max_attempts", "run_at", "created_at", "finished_at" }

function QueueStore:get(queue, id)
    local job = self.client:call("HGETALL", `$(base_of(self, queue)[1])job:$id`)
    if job.id == nil then
        return nil
    end
    for i = 1, #JOB_NUMBERS do
        local name = JOB_NUMBERS[i]
        if job[name] ~= nil then
            job[name] = tonumber(job[name])
        end
    end
    job.seq = nil
    return job
end

function QueueStore:stats(queue, now)
    local reply = self.stats_script(base_of(self, queue), whole(now))
    return {
        waiting = reply[1],
        delayed = reply[2],
        active = reply[3],
        completed = reply[4],
        failed = reply[5],
    }
end

function QueueStore:next_at(queue)
    return self.next_at_script(base_of(self, queue))
end

function QueueStore:retry_failed(queue, now)
    return self.retry_failed_script(base_of(self, queue), whole(now))
end

function QueueStore:clean(queue, status, before)
    return self.clean_script(base_of(self, queue), status, whole(before))
end

function QueueStore:close()
end

--- Returns a store for the `queue` package that keeps its jobs in Redis.
---
--- The store has the methods that `queue` documents, so the workers of
--- several processes share one queue. Each job is a hash. Sorted sets
--- order the jobs by due time, by priority, and by the end of their lease.
--- Every method that changes a job runs as one Lua script on the server. A
--- claim is therefore atomic, so two workers never receive the same job.
--- `complete` and `fail` change a job only while it is active with the
--- attempts of the caller, which leaves a job whose lease ran out to the
--- worker that claimed it next.
---
--- The option `prefix` starts every key and defaults to `"queue:"`. The
--- name of the queue follows it between braces, which keeps the keys of one
--- queue in one slot of a cluster. `close` leaves the client open.
---
--- Each method raises the errors of `r:call`.
--- @param client table The client from `redis.connect`.
--- @param options table? `prefix`.
--- @return table The store.
function M.queue_store(client, options)
    return setmetatable({
        client = client,
        prefix = options and options.prefix or "queue:",
        add_script = client:script(QUEUE_ADD),
        claim_script = client:script(QUEUE_CLAIM),
        complete_script = client:script(QUEUE_COMPLETE),
        fail_script = client:script(QUEUE_FAIL),
        stats_script = client:script(QUEUE_STATS),
        next_at_script = client:script(QUEUE_NEXT_AT),
        retry_failed_script = client:script(QUEUE_RETRY_FAILED),
        clean_script = client:script(QUEUE_CLEAN),
    }, QueueStore)
end

return M
